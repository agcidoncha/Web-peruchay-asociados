---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Faq from "../components/Faq.astro";
import Hero from "../components/home/Hero.astro";
import Areas from "../components/home/Areas.astro";
import Diagnostico from "../components/home/Diagnostico.astro";
import TeamTransition from "../components/home/TeamTransition.astro";
import Team from "../components/home/Team.astro";
import Contact from "../components/home/Contact.astro";
import IconLinkList from "../components/IconLinkList.astro";

const faqCategories = ["Información general", "Colaboración y contratación"];

const faqs = [
	{
		cat: "Información general",
		q: "¿Cómo empieza la colaboración?",
		a: "El primer paso es conocer la situación de la empresa, sus necesidades y los objetivos que quiere alcanzar. A partir de esa primera conversación definimos el alcance del proyecto y proponemos la solución que mejor se adapte a cada caso.",
	},
	{
		cat: "Información general",
		q: "¿Tengo que contratar todos los servicios?",
		a: "No. Puedes contratar únicamente el servicio que necesites: Control de Gestión, Planificación y Análisis Financiero, Contabilidad, Fiscalidad, Digitalización o Automatización. También es posible combinar varios servicios cuando el proyecto lo requiera.",
	},
	{
		cat: "Información general",
		q: "¿Trabajáis con empresas de cualquier sector?",
		a: "Sí. Adaptamos nuestra metodología de trabajo a las características de cada empresa, independientemente de su actividad, tamaño u organización.",
	},
	{
		cat: "Información general",
		q: "¿Cómo es la comunicación durante el proyecto?",
		a: "La comunicación es directa, clara y orientada a la toma de decisiones. La frecuencia y el formato de las reuniones se adaptan a las necesidades de cada proyecto.",
	},
	{
		cat: "Información general",
		q: "¿Dónde estáis ubicados?",
		a: "Perucha y Asociados presta servicios a empresas y profesionales de toda la Comunidad de Madrid. Trabajamos de forma telemática, presencial o mediante un modelo híbrido, adaptándonos a las necesidades de cada proyecto. Cuando es necesario, nos desplazamos a las instalaciones del cliente para ofrecer un servicio más cercano y eficaz.",
	},
	{
		cat: "Colaboración y contratación",
		q: "¿Cómo puedo solicitar un presupuesto?",
		a: "Puedes ponerte en contacto con nosotros a través del formulario de la web, por teléfono o por correo electrónico. Tras una primera conversación para conocer tu empresa y tus necesidades, prepararemos una propuesta adaptada a tu proyecto.",
	},
	{
		cat: "Colaboración y contratación",
		q: "¿La primera reunión tiene algún coste?",
		a: "La primera toma de contacto tiene como objetivo conocer tu empresa, entender tus necesidades y valorar cómo podemos ayudarte. A partir de esa información te indicaremos la solución que mejor se adapte a tu situación.",
	},
	{
		cat: "Colaboración y contratación",
		q: "¿Cómo calculáis el precio de vuestros servicios?",
		a: "Cada empresa es diferente. El presupuesto se elabora teniendo en cuenta el alcance del proyecto, el volumen de trabajo, la complejidad de los servicios contratados y el nivel de acompañamiento requerido. Nuestro objetivo es ofrecer una propuesta personalizada y ajustada a las necesidades reales de cada cliente.",
	},
	{
		cat: "Colaboración y contratación",
		q: "¿Trabajáis con cuotas mensuales o por proyectos?",
		a: "Depende del servicio contratado. Algunos servicios, como la contabilidad, la fiscalidad o el control de gestión, suelen prestarse de forma periódica mediante una cuota mensual. Otros, como la digitalización o la automatización de procesos, se desarrollan habitualmente como proyectos con un alcance previamente definido.",
	},
	{
		cat: "Colaboración y contratación",
		q: "¿Puedo ampliar los servicios más adelante?",
		a: "Sí. Muchos clientes comienzan contratando un único servicio y, a medida que evolucionan sus necesidades, incorporan nuevas áreas de colaboración. Nuestra forma de trabajar es flexible y se adapta al crecimiento de cada empresa.",
	},
	{
		cat: "Colaboración y contratación",
		q: "¿Firmáis acuerdos de confidencialidad?",
		a: "Sí. Toda la información de nuestros clientes se trata con absoluta confidencialidad. Cuando el proyecto lo requiere, podemos formalizar un acuerdo de confidencialidad (NDA) para ofrecer mayores garantías y proteger la información compartida durante la colaboración.",
	},
	{
		cat: "Colaboración y contratación",
		q: "¿Cómo es el proceso de incorporación como cliente?",
		a: "Comenzamos con una reunión inicial para conocer la empresa, sus necesidades y objetivos. A continuación, definimos el alcance del servicio, presentamos una propuesta personalizada y, una vez aceptada, planificamos la puesta en marcha del proyecto para que la incorporación sea ágil y ordenada.",
	},
	{
		cat: "Colaboración y contratación",
		q: "¿Existe un periodo mínimo de permanencia?",
		a: "Depende del tipo de servicio contratado. Los servicios recurrentes se regulan mediante las condiciones acordadas con cada cliente, mientras que los proyectos tienen una duración vinculada a los objetivos y al alcance definidos en la propuesta.",
	},
];

const structuredData = {
	"@context": "https://schema.org",
	"@type": "ProfessionalService",
	name: "Perucha y Asociados",
	telephone: "+34639003817",
	url: "https://peruchayasociados.com",
};

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqs.map((faq) => ({
		"@type": "Question",
		name: faq.q,
		acceptedAnswer: {
			"@type": "Answer",
			text: faq.a,
		},
	})),
};

// Mismos datos que Areas.astro, presentados aquí en formato de lista (solo para mobile).
const areasList = [
	{
		href: "/finanzas-y-control",
		title: "Finanzas y Control",
		text: "Información, análisis y control para tomar decisiones con fundamento.",
		linkLabel: "Conocer el área",
		icon: '<path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path><path d="M22 12A10 10 0 0 0 12 2v10z"></path>',
	},
	{
		href: "/contabilidad-y-fiscalidad",
		title: "Contabilidad y Fiscalidad",
		text: "Gestión contable y fiscal rigurosa, con el respaldo de más de 30 años de experiencia.",
		linkLabel: "Conocer el área",
		icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path><path d="M9 13h6"></path><path d="M9 17h6"></path>',
	},
	{
		href: "/digitalizacion-y-automatizacion",
		title: "Digitalización y Automatización",
		text: "Tecnología y automatización de procesos para trabajar de forma más eficiente.",
		linkLabel: "Conocer el área",
		icon: '<circle cx="6" cy="6" r="2.5"></circle><circle cx="18" cy="6" r="2.5"></circle><circle cx="12" cy="18" r="2.5"></circle><path d="M8.2 7.2L12 15.5"></path><path d="M15.8 7.2L12 15.5"></path><path d="M8.5 6h7"></path>',
	},
];

// Mismos enlaces que la lista "tools" de Header.astro (solo para mobile; el Diagnóstico rápido
// es aquí su propia caja, no forma parte de esta lista).
const simuladores = [
	{
		href: "/finanzas-y-control#simulador",
		title: "Calcula tu punto de equilibrio",
		linkLabel: "Abrir simulador",
		icon: '<path d="M12 3v18"></path><path d="M5 7l-2 5a3 3 0 0 0 6 0z"></path><path d="M19 7l-2 5a3 3 0 0 0 6 0z"></path><path d="M5 7h14"></path><path d="M8 21h8"></path>',
	},
	{
		href: "/contabilidad-y-fiscalidad#simulador",
		title: "Autónomo o sociedad",
		linkLabel: "Abrir simulador",
		icon: '<circle cx="9" cy="8" r="3"></circle><path d="M2 20c0-3.3 3-5 7-5s7 1.7 7 5"></path><path d="M17 8a3 3 0 1 1 0 6"></path><path d="M22 20c0-2.7-1.8-4.2-4-4.7"></path>',
	},
	{
		href: "/digitalizacion-y-automatizacion#simulador",
		title: "Horas que podrás ahorrar",
		linkLabel: "Abrir simulador",
		icon: '<circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>',
	},
];
---

<Layout
	title="Perucha y Asociados — Control de gestión, contabilidad y digitalización para empresas"
	description="Control de gestión y análisis financiero, contabilidad y fiscalidad, digitalización y automatización para empresas. Más de 30 años de experiencia profesional en la Comunidad de Madrid."
>
	<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<Header />

	<main>
		<!-- Escritorio: Hero con carrusel, botones y avales -->
		<div class="desktop-only">
			<Hero />
		</div>

		<!-- Mobile: Hero simplificado + caja del diagnóstico -->
		<section class="mobile-only hero-lab">
			<div class="wrap">
				<p class="eyebrow">Asesoría para empresas</p>
				<h1>Soluciones para tu empresa.</h1>
				<p class="subtitle">Control de gestión, contabilidad, fiscalidad y digitalización adaptados a cada empresa.</p>

				<div class="diagnostico-teaser">
					<div class="teaser-text">
						<h2>¿Qué necesita tu empresa?</h2>
						<p>Responde unas preguntas y descubre qué área puede ayudarte.</p>
						<button type="button" class="btn-teaser" data-open-diagnostico aria-expanded="false" aria-controls="diagnostico-panel">
							Empezar diagnóstico
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>
						</button>
					</div>
				</div>
			</div>
		</section>

		<div class="desktop-only">
			<Areas />
		</div>

		<!-- Diagnóstico real: se usa tanto en escritorio (siempre visible) como en mobile (plegable) -->
		<div id="diagnostico-panel" class="diagnostico-wrap">
			<Diagnostico />
		</div>

		<div class="desktop-only">
			<TeamTransition />
			<Team />
		</div>

		<div class="mobile-only">
			<IconLinkList title="¿En qué podemos ayudarte?" items={areasList} variant="light" />
			<IconLinkList title="Simuladores para tu empresa" items={simuladores} variant="dark" />
		</div>

		<div class="desktop-only">
			<Faq categories={faqCategories} faqs={faqs} />
		</div>

		<section class="mobile-only contacto-teaser">
			<div class="wrap">
				<h2>¿No sabes por dónde empezar?</h2>
				<p>Cuéntanos tu situación y te orientamos sin compromiso.</p>
				<button type="button" class="btn-teaser" data-open-contacto aria-expanded="false" aria-controls="contacto-panel">
					Cuéntanos tu caso
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>
				</button>
			</div>
		</section>

		<!-- Contacto real: se usa tanto en escritorio (siempre visible) como en mobile (plegable) -->
		<div id="contacto-panel" class="contacto-wrap">
			<Contact />
		</div>
	</main>

	<Footer />
</Layout>

<style>
	/*
	 * En escritorio esta página se ve exactamente igual que siempre: se ocultan todos los
	 * bloques exclusivos de mobile. Solo por debajo de 600px se invierte: se ocultan los
	 * bloques de escritorio y se muestran los de mobile. Diagnóstico y Contacto NO tienen
	 * "mobile-only"/"desktop-only": es el mismo componente en los dos casos, solo cambia
	 * si puede plegarse (ver .diagnostico-wrap/.contacto-wrap).
	 */
	.mobile-only {
		display: none;
	}

	@media (max-width: 599px) {
		.desktop-only {
			display: none;
		}

		.mobile-only {
			display: block;
		}

		.diagnostico-wrap[hidden],
		.contacto-wrap[hidden] {
			display: none;
		}
	}

	.hero-lab {
		padding: 25px 15px 40px;
		background: var(--color-accent-100);
	}

	.hero-lab .wrap {
		max-width: 480px;
		margin: 0 auto;
	}

	.eyebrow {
		font-family: var(--font-body);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-accent);
		margin: 0 0 12px;
	}

	h1 {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: clamp(30px, 8vw, 38px);
		line-height: 1.1;
		color: var(--color-text);
		margin: 0 0 14px;
	}

	.subtitle {
		font-family: var(--font-body);
		font-size: 15px;
		line-height: 1.55;
		color: var(--color-muted);
		margin: 0 0 24px;
	}

	.diagnostico-teaser {
		background: var(--color-accent-900);
		border-radius: 20px;
		padding: 24px;
	}

	.teaser-text h2 {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 20px;
		color: #fff;
		margin: 0 0 8px;
	}

	.teaser-text p {
		font-family: var(--font-body);
		font-size: 14px;
		line-height: 1.5;
		color: rgba(255, 255, 255, 0.7);
		margin: 0 0 20px;
	}

	.contacto-teaser {
		padding: 25px 15px;
		text-align: center;
		background: var(--color-accent-100);
	}

	.contacto-teaser .wrap {
		max-width: 480px;
		margin: 0 auto;
	}

	.contacto-teaser h2 {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: clamp(22px, 3vw, 28px);
		color: var(--color-text);
		margin: 0 0 10px;
	}

	.contacto-teaser p {
		font-family: var(--font-body);
		font-size: 15px;
		color: var(--color-muted);
		margin: 0 0 20px;
	}

	.btn-teaser {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 15px;
		color: var(--color-accent-900);
		background: var(--color-accent-200);
		border: none;
		padding: 14px 26px;
		border-radius: 999px;
		cursor: pointer;
	}

	.btn-teaser:hover {
		background: #fff;
	}

	.contacto-teaser .btn-teaser {
		color: #fff;
		background: var(--color-accent-900);
	}

	.contacto-teaser .btn-teaser:hover {
		background: var(--color-accent-800);
	}
</style>

<script>
	const MOBILE_QUERY = "(max-width: 599px)";

	function toggle(buttonSelector: string, panelId: string) {
		const button = document.querySelector<HTMLButtonElement>(buttonSelector);
		const panel = document.getElementById(panelId);
		if (!button || !panel) return;

		function open() {
			panel!.hidden = false;
			button!.setAttribute("aria-expanded", "true");
		}

		function close() {
			panel!.hidden = true;
			button!.setAttribute("aria-expanded", "false");
		}

		// Solo se pliega en mobile; en escritorio el panel siempre está visible.
		if (window.matchMedia(MOBILE_QUERY).matches) {
			close();
		}

		button.addEventListener("click", () => {
			const isOpen = button.getAttribute("aria-expanded") === "true";
			if (isOpen) {
				close();
			} else {
				open();
				panel.scrollIntoView({ behavior: "smooth", block: "start" });
			}
		});

		return { open, close };
	}

	toggle("[data-open-diagnostico]", "diagnostico-panel");
	const contactoToggle = toggle("[data-open-contacto]", "contacto-panel");

	// El botón "Hablemos" del menú (móvil) debe abrir esta misma caja de contacto,
	// en vez de navegar a /#contacto. En escritorio no hace falta interceptarlo:
	// el contacto ya está siempre visible ahí.
	if (window.matchMedia(MOBILE_QUERY).matches) {
		document.querySelectorAll<HTMLAnchorElement>('a[href="/#contacto"]').forEach((link) => {
			link.addEventListener("click", (event) => {
				event.preventDefault();
				contactoToggle?.open();
				document.getElementById("contacto-panel")?.scrollIntoView({ behavior: "smooth", block: "start" });
			});
		});
	}

	// Si un simulador (de esta misma página o de otra) ha dejado datos prellenados,
	// Contact.astro avisa con este evento para que abramos la caja automáticamente en mobile.
	// El script de Contact.astro puede ejecutarse antes de que este listener quede
	// registrado, así que además comprobamos la bandera directamente al cargar.
	function abrirContactoPrellenado() {
		if (!window.matchMedia(MOBILE_QUERY).matches) return;
		contactoToggle?.open();
		document.getElementById("contacto-panel")?.scrollIntoView({ behavior: "smooth", block: "start" });
	}

	window.addEventListener("contacto:prellenado", abrirContactoPrellenado);

	if ((window as unknown as { __contactoPrellenado?: boolean }).__contactoPrellenado) {
		abrirContactoPrellenado();
	}
</script>
