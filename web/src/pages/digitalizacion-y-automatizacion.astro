---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Faq from "../components/Faq.astro";
import ClosingCta from "../components/ClosingCta.astro";
import AreaHero from "../components/AreaHero.astro";
import TextIntro from "../components/TextIntro.astro";
import NumberedServices from "../components/NumberedServices.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import SolutionsGrid from "../components/digitalizacion-y-automatizacion/SolutionsGrid.astro";
import ExperienceColumns from "../components/digitalizacion-y-automatizacion/ExperienceColumns.astro";
import ExampleQuotes from "../components/digitalizacion-y-automatizacion/ExampleQuotes.astro";
import EstimadorHoras from "../components/digitalizacion-y-automatizacion/EstimadorHoras.astro";
import RelatedAreas from "../components/RelatedAreas.astro";

const introParagraphs = [
	"No todas las empresas necesitan una solución estándar ni contratar una estructura externa completa. A veces necesitan un profesional con una visión amplia que pueda entender el objetivo, conectar distintas disciplinas y convertir una necesidad concreta en una solución funcional.",
	"Esta área reúne diseño, maquetación, desarrollo web, programación y automatización con inteligencia artificial. Esto permite abordar un proyecto desde su imagen y experiencia visual hasta su funcionamiento técnico, sus integraciones y la mejora de sus procesos internos.",
	"Podemos crear una nueva presencia digital, renovar herramientas existentes, automatizar tareas repetitivas o desarrollar una solución específica para una necesidad que no encaja en un producto genérico.",
];

const services = [
	{
		n: "01",
		title: "Identidad visual e imagen corporativa",
		text: "Creamos o actualizamos la identidad visual de la empresa para que transmita una imagen profesional, coherente y reconocible en todos sus canales.",
		items: [
			"Identidad visual y criterios de marca",
			"Logotipo y sus aplicaciones",
			"Paleta de colores y tipografías",
			"Manuales y guías de uso",
			"Presentaciones corporativas",
			"Documentación comercial",
			"Plantillas de comunicación",
			"Materiales digitales e impresos",
		],
	},
	{
		n: "02",
		title: "Diseño y desarrollo web",
		text: "Diseñamos y desarrollamos páginas y soluciones web adaptadas a los objetivos, contenidos y operativa de cada organización.",
		items: [
			"Webs corporativas",
			"Landing pages y micrositios",
			"Portales privados y áreas de cliente",
			"Catálogos y tiendas online",
			"Intranets y herramientas internas",
			"Rediseño de webs existentes",
			"Arquitectura de contenidos y UX",
			"Maquetación responsive",
			"Rendimiento, accesibilidad y SEO técnico",
			"Integración con formularios, BBDD y APIs",
		],
	},
	{
		n: "03",
		title: "Herramientas y desarrollos a medida",
		text: "Cuando una hoja de cálculo, una aplicación estándar o un proceso manual ya no son suficientes, desarrollamos una herramienta específica para la empresa.",
		items: [
			"Paneles de control y cuadros de mando",
			"Aplicaciones internas de gestión",
			"Formularios y flujos de aprobación",
			"Generadores de informes y documentos",
			"Sistemas para organizar archivos o datos",
			"Calculadoras y configuradores",
			"Conexiones entre plataformas aisladas",
			"Soluciones web para clientes o equipos",
		],
	},
	{
		n: "04",
		title: "Digitalización de procesos",
		text: "Analizamos procesos que todavía dependen de correos, documentos dispersos, introducción manual de datos o tareas difíciles de seguir.",
		items: [
			"Gestión documental",
			"Recogida y validación de información",
			"Facturación y administración",
			"Seguimiento de clientes o proyectos",
			"Organización de solicitudes internas",
			"Preparación de informes",
			"Comunicación entre departamentos",
			"Centralización de datos y documentos",
		],
	},
	{
		n: "05",
		title: "Automatización de tareas y flujos de trabajo",
		text: "Identificamos tareas repetitivas, reglas que se ejecutan siempre de la misma forma y procesos que requieren trasladar información manualmente entre varias aplicaciones.",
		items: [
			"Introducción y traslado de datos",
			"Generación y envío de documentos",
			"Creación periódica de informes",
			"Avisos y notificaciones",
			"Tratamiento de formularios",
			"Organización de archivos",
			"Actualización de registros",
			"Procesos administrativos con reglas definidas",
		],
	},
	{
		n: "06",
		title: "Inteligencia artificial aplicada a la empresa",
		text: "Estudiamos cómo incorporar inteligencia artificial a procesos concretos, evitando implantarla únicamente por tendencia.",
		items: [
			"Clasificación y extracción de información",
			"Búsqueda sobre documentación interna",
			"Borradores, resúmenes e informes",
			"Asistentes internos para tareas concretas",
			"Análisis de grandes volúmenes de contenido",
			"Generación asistida de materiales",
			"Flujos con IA, reglas y revisión humana",
		],
	},
	{
		n: "07",
		title: "Integraciones entre herramientas",
		text: "Muchas ineficiencias aparecen porque cada departamento o aplicación trabaja con información aislada. Diseñamos conexiones para que los datos circulen con menos intervención manual.",
		items: [
			"Formularios y bases de datos",
			"CRM y herramientas comerciales",
			"Sistemas de facturación o gestión",
			"Correo y almacenamiento",
			"Hojas de cálculo y paneles",
			"APIs y servicios externos",
			"Aplicaciones a medida",
		],
	},
];

const steps = [
	{
		n: "01",
		title: "Entendemos la necesidad",
		text: "Revisamos el problema, las personas implicadas, las herramientas actuales y el resultado esperado.",
	},
	{
		n: "02",
		title: "Definimos una solución viable",
		text: "Delimitamos alcance, prioridades e integraciones. Cuando conviene, comenzamos con una prueba de concepto.",
	},
	{
		n: "03",
		title: "Diseñamos y desarrollamos",
		text: "Creamos la solución con comunicación directa y validaciones durante el proceso.",
	},
	{
		n: "04",
		title: "Implantamos y documentamos",
		text: "Preparamos la puesta en marcha, las instrucciones de uso y la documentación necesaria.",
	},
	{
		n: "05",
		title: "Mejoramos cuando es necesario",
		text: "La solución puede ajustarse o evolucionar a partir de nuevas necesidades y del aprendizaje obtenido.",
	},
];

const faqCategories = ["Digitalización", "Automatización", "Inteligencia Artificial"];

const faqs = [
	{
		cat: "Digitalización",
		q: "¿Qué entendéis por digitalización empresarial?",
		a: "La digitalización consiste en incorporar herramientas y procesos digitales que mejoren la organización, la eficiencia y la gestión de la empresa.",
	},
	{
		cat: "Digitalización",
		q: "¿Cómo sé si mi empresa necesita digitalizarse?",
		a: "Si existen tareas manuales, duplicidad de información, dificultades para acceder a los datos o falta de integración entre herramientas, probablemente exista margen de mejora.",
	},
	{
		cat: "Digitalización",
		q: "¿Qué procesos pueden digitalizarse?",
		a: "La gestión documental, la facturación, la relación con clientes, la organización interna y muchos otros procesos administrativos pueden beneficiarse de la digitalización.",
	},
	{
		cat: "Digitalización",
		q: "¿Es necesario cambiar todos los programas que utilizo?",
		a: "No. Siempre analizamos primero las herramientas existentes para valorar si pueden aprovecharse antes de proponer nuevas soluciones.",
	},
	{
		cat: "Digitalización",
		q: "¿Trabajáis con empresas de cualquier tamaño?",
		a: "Sí. Adaptamos las soluciones digitales al tamaño, los recursos y las necesidades de cada organización.",
	},
	{
		cat: "Automatización",
		q: "¿Qué procesos pueden automatizarse?",
		a: "Aquellas tareas repetitivas, administrativas o con poco valor añadido, como la introducción de datos, la generación de documentos o el intercambio de información entre aplicaciones.",
	},
	{
		cat: "Automatización",
		q: "¿Cómo sabéis si un proceso puede automatizarse?",
		a: "Analizamos el proceso actual, el tiempo que consume, las herramientas utilizadas y el resultado esperado para determinar si la automatización aporta un beneficio real.",
	},
	{
		cat: "Automatización",
		q: "¿Qué herramientas utilizáis?",
		a: "Seleccionamos las herramientas más adecuadas para cada proyecto en función de las necesidades del cliente y del grado de automatización requerido.",
	},
	{
		cat: "Automatización",
		q: "¿La automatización sustituye al equipo?",
		a: "No. Su objetivo es eliminar tareas repetitivas para que las personas puedan dedicar más tiempo a actividades que aportan mayor valor.",
	},
	{
		cat: "Automatización",
		q: "¿Qué ahorro puede conseguir mi empresa?",
		a: "Depende del proceso analizado. La automatización suele reducir tiempos, minimizar errores y mejorar la productividad del equipo.",
	},
	{
		cat: "Automatización",
		q: "¿Qué diferencia hay entre digitalizar y automatizar un proceso?",
		a: "Digitalizar consiste en convertir procesos manuales en procesos digitales. Automatizar supone un paso más: conseguir que determinadas tareas se ejecuten automáticamente, reduciendo tiempos, errores y trabajo repetitivo.",
	},
	{
		cat: "Inteligencia Artificial",
		q: "¿También implantáis soluciones de inteligencia artificial?",
		a: "Sí. Estudiamos cómo incorporar herramientas de inteligencia artificial que aporten valor real a la empresa y mejoren sus procesos de trabajo.",
	},
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqs.map((faq) => ({
		"@type": "Question",
		name: faq.q,
		acceptedAnswer: {
			"@type": "Answer",
			text: faq.a,
		},
	})),
};
---

<Layout
	title="Digitalización y Automatización | Perucha y Asociados — Diseño, desarrollo y automatización"
	description="Identidad visual, diseño y desarrollo web, herramientas a medida, digitalización y automatización de procesos con inteligencia artificial. Más de 20 años de experiencia en diseño y desarrollo."
>
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
	<Header active="digitalizacion-y-automatizacion" />

	<main>
		<AreaHero
			eyebrow="Digitalización y Automatización"
			title="Diseño, tecnología y automatización al servicio de tu empresa"
			description="Automatización de procesos con inteligencia artificial, desarrollo web y diseño visual, con el respaldo de más de 20 años de experiencia en diseño y desarrollo."
			ctaLabel="Cuéntanos qué necesitas resolver"
			photoLabel="Foto: trabajo de diseño/desarrollo"
			image="/images/hero-pages/digitalizacion-y-automatizacion-hero-page.webp"
			imageAlt="Digitalización y Automatización — diseño y desarrollo"
		/>
		<TextIntro paragraphs={introParagraphs} />
		<NumberedServices title="Qué podemos hacer por tu empresa" services={services} />
		<SolutionsGrid />
		<ExperienceColumns />
		<ProcessSteps title="Cómo trabajamos" steps={steps} />
		<ExampleQuotes />
		<EstimadorHoras />
		<Faq categories={faqCategories} faqs={faqs} />
		<RelatedAreas
			title="La automatización también puede aplicarse a estas áreas"
			areas={[
				{
					href: "/finanzas-y-control",
					title: "Finanzas y Control",
					text: "Información, análisis y control para conocer mejor el negocio y tomar decisiones con fundamento.",
				},
				{
					href: "/contabilidad-y-fiscalidad",
					title: "Contabilidad y Fiscalidad",
					text: "Gestión contable y fiscal rigurosa, con el respaldo de más de 30 años de experiencia profesional.",
				},
			]}
		/>
		<ClosingCta
			title="¿Tienes una necesidad digital y no encuentras una solución que encaje?"
			text="Cuéntanos cómo trabajáis actualmente, qué problema queréis resolver y qué resultado necesitáis. Analizaremos el caso para proponeros una solución proporcionada, viable y adaptada a vuestra empresa."
			ctaLabel="Hablar sobre el proyecto"
		/>
	</main>

	<Footer />
</Layout>
