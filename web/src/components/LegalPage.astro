---
interface Props {
	eyebrow: string;
	title: string;
	lastUpdated: string;
}

const { eyebrow, title, lastUpdated } = Astro.props;
---

<section class="legal">
	<div class="wrap">
		<p class="eyebrow">{eyebrow}</p>
		<h1>{title}</h1>
		<div class="content">
			<slot />
		</div>
		<p class="updated">Última actualización: {lastUpdated}.</p>
	</div>
</section>

<style>
	.legal {
		padding: 64px 24px 96px;
		background: var(--color-bg);
	}

	.wrap {
		max-width: 760px;
		margin: 0 auto;
	}

	.eyebrow {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 13px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-accent);
		margin: 0 0 14px;
	}

	h1 {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: clamp(28px, 4vw, 42px);
		line-height: 1.15;
		color: var(--color-accent-900);
		margin: 0 0 40px;
	}

	.content {
		font-family: var(--font-body);
		font-size: 15.5px;
		line-height: 1.7;
		color: var(--color-text);
	}

	.content :global(h2) {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 22px;
		color: var(--color-text);
		margin: 40px 0 14px;
	}

	.content :global(h2:first-child) {
		margin-top: 0;
	}

	.content :global(p) {
		margin: 0 0 16px;
	}

	.content :global(ul) {
		margin: 0 0 16px;
		padding-left: 22px;
	}

	.content :global(li) {
		margin: 0 0 8px;
	}

	.content :global(strong) {
		color: var(--color-accent-900);
	}

	.content :global(code) {
		font-family: monospace;
		font-size: 13px;
		background: var(--color-accent-100);
		padding: 2px 6px;
		border-radius: 4px;
	}

	.content :global(a) {
		color: var(--color-accent-800);
	}

	.content :global(.pending) {
		color: var(--color-accent-700);
		font-style: italic;
	}

	.content :global(table) {
		display: block;
		overflow-x: auto;
		max-width: 100%;
		width: 100%;
		border-collapse: collapse;
		margin: 0 0 20px;
		font-size: 14px;
	}

	.content :global(th),
	.content :global(td) {
		text-align: left;
		padding: 10px 12px;
		border: 1px solid var(--color-divider);
		vertical-align: top;
	}

	.content :global(th) {
		background: var(--color-accent-100);
		font-family: var(--font-heading);
		font-weight: 600;
	}

	.updated {
		margin-top: 48px;
		padding-top: 20px;
		border-top: 1px solid var(--color-divider);
		font-size: 13px;
		font-style: italic;
		color: var(--color-muted);
	}
</style>
