---
interface Area {
	href: string;
	title: string;
	text: string;
}

interface Props {
	title: string;
	areas: Area[];
}

const { title, areas } = Astro.props;
---

<section class="related-areas">
	<div class="wrap">
		<p class="eyebrow">También te puede interesar</p>
		<h2>{title}</h2>
		<div class="grid" style={`--cols: ${areas.length}`}>
			{areas.map((area) => (
				<a href={area.href} class="card">
					<div class="body">
						<h3>{area.title}</h3>
						<p>{area.text}</p>
						<span class="link">Conocer el área →</span>
					</div>
				</a>
			))}
		</div>
	</div>
</section>

<style>
	.related-areas {
		padding: 72px 24px;
		background: var(--color-bg);
	}

	.wrap {
		max-width: 940px;
		margin: 0 auto;
	}

	.eyebrow {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 13px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-accent);
		margin: 0 0 12px;
		text-align: center;
	}

	h2 {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: clamp(24px, 3vw, 32px);
		color: var(--color-text);
		margin: 0 0 32px;
		text-align: center;
	}

	.grid {
		display: grid;
		gap: 20px;
	}

	.card {
		display: block;
		background: #fff;
		border: 1px solid var(--color-divider);
		border-radius: 18px;
		padding: 26px;
		text-decoration: none;
		transition: border-color 0.2s ease;
	}

	.card:hover {
		border-color: var(--color-accent-300);
	}

	.card h3 {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 18px;
		color: var(--color-text);
		margin: 0 0 8px;
	}

	.card p {
		font-family: var(--font-body);
		font-size: 14.5px;
		line-height: 1.55;
		color: var(--color-muted);
		margin: 0 0 14px;
	}

	.card .link {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 14px;
		color: var(--color-accent-800);
	}

	@media (min-width: 640px) {
		.grid {
			grid-template-columns: repeat(var(--cols, 2), 1fr);
		}
	}

	@media (max-width: 599px) {
		.related-areas {
			padding: 25px 15px;
		}
	}
</style>
