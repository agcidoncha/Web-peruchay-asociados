---
---

<div id="cookie-banner" class="cookie-banner" role="region" aria-label="Aviso de cookies" hidden>
	<div class="banner-inner">
		<div class="banner-copy">
			<p class="banner-title">Tu privacidad, tu elección</p>
			<p class="banner-text">
				Utilizamos tecnologías necesarias para que la web funcione. Con tu permiso, también podremos
				utilizar cookies analíticas para conocer cómo se usa la web y mejorarla. Puedes aceptar, rechazar o
				configurar tus preferencias. Consulta la <a href="/politica-cookies">Política de cookies</a>.
			</p>
		</div>
		<div class="banner-actions">
			<button type="button" class="btn-outline" data-cookie-reject>Rechazar</button>
			<button type="button" class="btn-outline" data-cookie-configure>Configurar</button>
			<button type="button" class="btn-solid" data-cookie-accept>Aceptar</button>
		</div>
	</div>
</div>

<style>
	.cookie-banner {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 90;
		max-width: 100vw;
		box-sizing: border-box;
		background: #fff;
		border-top: 1px solid var(--color-divider);
		box-shadow: 0 -8px 24px rgba(31, 41, 55, 0.12);
		padding: 20px 24px;
	}

	.cookie-banner[hidden] {
		display: none;
	}

	.banner-inner {
		max-width: 1180px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.banner-title {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 17px;
		color: var(--color-text);
		margin: 0 0 6px;
	}

	.banner-text {
		font-family: var(--font-body);
		font-size: 13.5px;
		line-height: 1.55;
		color: var(--color-muted);
		margin: 0;
		max-width: 720px;
	}

	.banner-text a {
		color: var(--color-accent-dark);
	}

	.banner-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.btn-outline,
	.btn-solid {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 14px;
		border-radius: 999px;
		padding: 11px 22px;
		cursor: pointer;
	}

	.btn-outline {
		background: transparent;
		border: 1.5px solid var(--color-divider);
		color: var(--color-text);
	}

	.btn-outline:hover {
		border-color: var(--color-accent-300);
	}

	.btn-solid {
		background: var(--color-accent-900);
		border: 1.5px solid var(--color-accent-900);
		color: #fff;
	}

	.btn-solid:hover {
		background: var(--color-accent-800);
	}

	@media (min-width: 800px) {
		.banner-inner {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
		}
	}
</style>

<script>
	import { needsConsent, saveConsent, OPEN_SETTINGS_EVENT } from "../lib/cookieConsent";

	const banner = document.querySelector<HTMLElement>("#cookie-banner");

	if (banner && needsConsent()) {
		banner.hidden = false;
	}

	function hideBanner() {
		if (banner) banner.hidden = true;
	}

	banner?.querySelector("[data-cookie-accept]")?.addEventListener("click", () => {
		saveConsent({ analytics: true });
		hideBanner();
	});

	banner?.querySelector("[data-cookie-reject]")?.addEventListener("click", () => {
		saveConsent({ analytics: false });
		hideBanner();
	});

	banner?.querySelector("[data-cookie-configure]")?.addEventListener("click", () => {
		hideBanner();
		window.dispatchEvent(new CustomEvent(OPEN_SETTINGS_EVENT));
	});
</script>
