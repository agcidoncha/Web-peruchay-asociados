---
interface Service {
	n: string;
	title: string;
	text: string;
	items: string[];
}

interface Props {
	title: string;
	services: Service[];
}

const { title, services } = Astro.props;
---

<section class="services">
	<div class="wrap">
		<h2>{title}</h2>
		<div class="list">
			{services.map((service) => (
				<div class="card">
					<p class="n">{service.n}</p>
					<h3>{service.title}</h3>
					<p class="text">{service.text}</p>
					{service.items.length > 0 && (
						<ul>
							{service.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					)}
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.services {
		padding: 88px 24px;
		background: var(--color-surface);
	}

	.wrap {
		max-width: 1180px;
		margin: 0 auto;
	}

	h2 {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: clamp(26px, 3.6vw, 38px);
		text-align: center;
		color: var(--color-text);
		margin: 0 0 48px;
	}

	.list {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.card {
		background: #fff;
		border: 1px solid var(--color-divider);
		border-radius: 18px;
		padding: 30px 28px;
	}

	.n {
		margin: 0 0 8px;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 13px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-accent-700);
	}

	h3 {
		margin: 0 0 12px;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 20px;
		color: var(--color-text);
	}

	.text {
		margin: 0 0 16px;
		font-family: var(--font-body);
		font-size: 15px;
		line-height: 1.6;
		color: var(--color-muted);
	}

	.card .text:last-child {
		margin-bottom: 0;
	}

	ul {
		margin: 0;
		padding-left: 20px;
		display: grid;
		gap: 6px;
		font-family: var(--font-body);
		font-size: 14px;
		line-height: 1.6;
		color: var(--color-muted);
	}

	@media (min-width: 700px) {
		ul {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 599px) {
		.services {
			padding: 25px 15px;
		}
	}
</style>
