---
interface Props {
	title: string;
	description: string;
	ctaLabel: string;
	id?: string;
	eyebrow?: string;
}

const { title, description, ctaLabel, id, eyebrow = "Propuesta pendiente de confirmar" } = Astro.props;
---

<section id={id} class="tool-proposal">
	<div class="box">
		<span class="eyebrow">{eyebrow}</span>
		<h3>{title}</h3>
		<p>{description}</p>
		<a href="/#contacto" class="cta">{ctaLabel}</a>
	</div>
</section>

<style>
	.tool-proposal {
		padding: 64px 24px;
		background: var(--color-bg);
	}

	.box {
		max-width: 820px;
		margin: 0 auto;
		background: var(--color-accent-100);
		border: 1px dashed var(--color-accent-300);
		border-radius: 24px;
		padding: 44px 36px;
		text-align: center;
	}

	.eyebrow {
		display: inline-block;
		font-family: var(--font-body);
		font-size: 12.5px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-accent-700);
		background: #fff;
		padding: 6px 14px;
		border-radius: 999px;
		margin: 0 0 20px;
	}

	h3 {
		margin: 0 0 14px;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 24px;
		color: var(--color-text);
	}

	p {
		margin: 0 auto 22px;
		font-family: var(--font-body);
		font-size: 15px;
		line-height: 1.65;
		color: var(--color-muted);
		max-width: 600px;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 14px;
		color: var(--color-accent-800);
		border: 1.5px solid var(--color-accent-800);
		border-radius: 999px;
		padding: 10px 22px;
		text-decoration: none;
	}

	.cta:hover {
		background: var(--color-accent-800);
		color: #fff;
	}
</style>
