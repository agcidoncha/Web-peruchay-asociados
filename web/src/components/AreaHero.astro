---
interface Props {
	eyebrow: string;
	title: string;
	titleNote?: string;
	description: string;
	descriptionNote?: string;
	ctaLabel: string;
	photoLabel: string;
	image?: string;
	imageAlt?: string;
}

const { eyebrow, title, titleNote, description, descriptionNote, ctaLabel, photoLabel, image, imageAlt } = Astro.props;
---

<section class="hero">
	<div class="wrap">
		<div class="content">
			<span class="eyebrow">{eyebrow}</span>
			<h1>{title}</h1>
			{titleNote && <p class="note">{titleNote}</p>}
			<p class="description">{description}</p>
			{descriptionNote && <p class="note">{descriptionNote}</p>}
			<a href="/#contacto" class="cta">
				{ctaLabel}
				<span class="cta-icon">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg>
				</span>
			</a>
		</div>

		{image ? (
			<div class="visual visual-photo">
				<img src={image} alt={imageAlt ?? title} width="1000" height="1250" loading="eager" />
			</div>
		) : (
			<div class="visual" role="img" aria-label={`${photoLabel} — pendiente de definir`}>
				<span>{photoLabel}</span>
			</div>
		)}
	</div>
</section>

<style>
	.hero {
		background: var(--color-accent-100);
	}

	.wrap {
		max-width: 1180px;
		margin: 0 auto;
		padding: 56px 24px;
		display: grid;
		gap: 40px;
	}

	.eyebrow {
		display: inline-block;
		font-family: var(--font-body);
		font-size: 13px;
		color: var(--color-accent-800);
		background: #fff;
		padding: 6px 14px;
		border-radius: 8px;
		margin: 0 0 20px;
	}

	h1 {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: clamp(30px, 4.4vw, 46px);
		line-height: 1.12;
		letter-spacing: -0.01em;
		color: var(--color-accent-900);
		margin: 0 0 8px;
	}

	.note {
		font-size: 13px;
		color: var(--color-accent-700);
		font-style: italic;
		margin: 0 0 22px;
	}

	.description {
		font-family: var(--font-body);
		font-size: 17px;
		line-height: 1.6;
		color: var(--color-accent-700);
		max-width: 520px;
		margin: 0 0 6px;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 16px;
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 15px;
		color: #fff;
		background: var(--color-accent-900);
		padding: 6px 6px 6px 24px;
		border-radius: 999px;
		text-decoration: none;
	}

	.cta:hover {
		background: var(--color-accent-800);
	}

	.cta-icon {
		width: 38px;
		height: 38px;
		border-radius: 50%;
		background: #fff;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-accent-900);
		flex: 0 0 auto;
	}

	.visual {
		aspect-ratio: 4 / 5;
		width: 100%;
		border-radius: 20px;
		background: var(--color-surface);
		border: 1px dashed var(--color-divider);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-muted);
		font-family: var(--font-body);
		font-size: 14px;
		text-align: center;
		padding: 24px;
	}

	.visual-photo {
		border: none;
		padding: 0;
		overflow: hidden;
		box-shadow: var(--shadow-md);
	}

	.visual-photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (min-width: 900px) {
		.wrap {
			grid-template-columns: 1.05fr 0.95fr;
			align-items: center;
			padding: 88px 24px;
		}
	}
</style>
