<script>
	import { calcular, comunidadDisponible, type Comunidad, type EntradaSimulador } from "../../lib/fiscal/motorAutonomoVsSociedad";

	type PillGroup = "otros-ingresos" | "hijo-discapacidad" | "discapacidad" | "declaracion" | "retirada";

	const section = document.querySelector<HTMLElement>("#simulador.avs");
	if (section) {
		const stepViews = Array.from(section.querySelectorAll<HTMLElement>("[data-step]"));
		const stepLabel = section.querySelector<HTMLElement>("[data-step-label]");
		const stepPercent = section.querySelector<HTMLElement>("[data-step-percent]");
		const stepSubtitle = section.querySelector<HTMLElement>("[data-step-subtitle]");
		const progressFill = section.querySelector<HTMLElement>("[data-progress-fill]");

		const stepMeta = [
			{ label: "Paso 1 de 4 · Tu actividad", subtitle: "Compara ambos escenarios con los datos básicos de tu actividad." },
			{ label: "Paso 2 de 4 · Tu situación personal", subtitle: "Compara ambos escenarios con tu situación personal y familiar." },
			{ label: "Paso 3 de 4 · Sociedad", subtitle: "Define cómo funcionaría el escenario de sociedad." },
			{ label: "Paso 4 de 4 · Resultado", subtitle: "" },
		];

		let currentStep = 1;

		const pillGroups: Record<PillGroup, string> = {
			"otros-ingresos": "no",
			"hijo-discapacidad": "no",
			discapacidad: "no",
			declaracion: "individual",
			retirada: "",
		};

		function bindPillToggle(container: Element, onChange: (value: string) => void) {
			const buttons = Array.from(container.querySelectorAll<HTMLButtonElement>(".pill-btn"));
			buttons.forEach((btn) => {
				btn.addEventListener("click", () => {
					buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
					onChange(btn.dataset.value ?? "");
				});
			});
		}

		section.querySelectorAll<HTMLElement>("[data-toggle]").forEach((group) => {
			const key = group.dataset.toggle as PillGroup;
			bindPillToggle(group, (value) => {
				pillGroups[key] = value;
				if (key === "otros-ingresos") {
					const field = section.querySelector<HTMLElement>("[data-otros-ingresos-importe]");
					if (field) field.hidden = value !== "si";
				}
			});
		});

		const hijosSelect = section.querySelector<HTMLSelectElement>("#avs-hijos");
		const hijosMenores3Select = section.querySelector<HTMLSelectElement>("#avs-hijos-menores-3");
		hijosSelect?.addEventListener("change", () => {
			const numHijos = Number(hijosSelect.value);
			const hasHijos = numHijos > 0;
			const edadesField = section.querySelector<HTMLElement>("[data-edades-hijos]");
			const discapacidadField = section.querySelector<HTMLElement>("[data-hijo-discapacidad]");
			if (edadesField) edadesField.hidden = !hasHijos;
			if (discapacidadField) discapacidadField.hidden = !hasHijos;
			if (hijosMenores3Select) {
				Array.from(hijosMenores3Select.options).forEach((opt) => {
					opt.disabled = Number(opt.value) > numHijos;
				});
				if (Number(hijosMenores3Select.value) > numHijos) hijosMenores3Select.value = String(numHijos);
			}
		});

		function parseEsNumber(raw: string): number | null {
			let s = raw.trim().replace(/€/g, "").replace(/\s/g, "");
			if (!s) return null;
			const hasComma = s.includes(",");
			const hasDot = s.includes(".");
			if (hasComma && hasDot) {
				s = s.replace(/\./g, "").replace(",", ".");
			} else if (hasComma) {
				s = s.replace(",", ".");
			} else if (hasDot) {
				const parts = s.split(".");
				const lastPart = parts[parts.length - 1];
				if (parts.length > 1 && lastPart.length === 3) {
					s = parts.join("");
				}
			}
			const n = Number(s);
			return Number.isFinite(n) ? n : null;
		}

		function showError(step: number, message: string) {
			const el = section?.querySelector<HTMLElement>(`[data-error="${step}"]`);
			if (!el) return;
			el.textContent = message;
			el.hidden = false;
		}

		function clearError(step: number) {
			const el = section?.querySelector<HTMLElement>(`[data-error="${step}"]`);
			if (!el) return;
			el.hidden = true;
			el.textContent = "";
		}

		function validateStep1(): boolean {
			clearError(1);
			const comunidad = (section?.querySelector<HTMLSelectElement>("#avs-comunidad"))?.value;
			const ingresos = parseEsNumber((section?.querySelector<HTMLInputElement>("#avs-ingresos"))?.value ?? "");
			const gastos = parseEsNumber((section?.querySelector<HTMLInputElement>("#avs-gastos"))?.value ?? "");
			const otrosImporte = pillGroups["otros-ingresos"] === "si" ? parseEsNumber((section?.querySelector<HTMLInputElement>("#avs-otros-importe"))?.value ?? "") : 0;

			if (!comunidad) {
				showError(1, "Selecciona tu comunidad autónoma de residencia fiscal.");
				return false;
			}
			if (ingresos === null || gastos === null) {
				showError(1, "Completa los datos necesarios para realizar la comparación.");
				return false;
			}
			if (ingresos < 0 || gastos < 0) {
				showError(1, "Los ingresos no pueden ser negativos.");
				return false;
			}
			if (ingresos > 1000000) {
				showError(1, "Este caso requiere un estudio personalizado.");
				return false;
			}
			if (gastos >= ingresos) {
				showError(1, "Con los datos introducidos no existe un beneficio positivo que permita realizar esta comparación. Podemos revisar tu situación de forma personalizada.");
				return false;
			}
			if (pillGroups["otros-ingresos"] === "si" && (otrosImporte === null || otrosImporte < 0)) {
				showError(1, "Indica un importe válido de otros ingresos personales.");
				return false;
			}
			return true;
		}

		function beneficioPrevio(): number {
			const ingresos = parseEsNumber((section?.querySelector<HTMLInputElement>("#avs-ingresos"))?.value ?? "") ?? 0;
			const gastos = parseEsNumber((section?.querySelector<HTMLInputElement>("#avs-gastos"))?.value ?? "") ?? 0;
			return ingresos - gastos;
		}

		function validateStep2(): boolean {
			clearError(2);
			const edad = parseEsNumber((section?.querySelector<HTMLInputElement>("#avs-edad"))?.value ?? "");
			const civil = (section?.querySelector<HTMLSelectElement>("#avs-civil"))?.value;
			const dineroPersonal = parseEsNumber((section?.querySelector<HTMLInputElement>("#avs-dinero-personal"))?.value ?? "");

			if (edad === null || !civil || dineroPersonal === null) {
				showError(2, "Completa los datos necesarios para realizar la comparación.");
				return false;
			}
			if (edad < 16 || edad > 100) {
				showError(2, "Revisa la edad introducida.");
				return false;
			}
			if (dineroPersonal < 0) {
				showError(2, "Los costes no pueden ser negativos.");
				return false;
			}
			if (dineroPersonal > beneficioPrevio()) {
				showError(2, "La cantidad que deseas retirar supera el resultado disponible de la sociedad. Reduce el importe o revisa los datos.");
				return false;
			}
			return true;
		}

		function validateStep3(): boolean {
			clearError(3);
			const costes = parseEsNumber((section?.querySelector<HTMLInputElement>("#avs-costes"))?.value ?? "");
			const tipoIs = (section?.querySelector<HTMLSelectElement>("#avs-tipo-is"))?.value;
			if (!pillGroups.retirada) {
				showError(3, "Indica cómo retirarías el dinero.");
				return false;
			}
			if (!tipoIs) {
				showError(3, "Selecciona el tipo del Impuesto sobre Sociedades.");
				return false;
			}
			if (costes === null) {
				showError(3, "Completa los datos necesarios para realizar la comparación.");
				return false;
			}
			if (costes < 0) {
				showError(3, "Los costes no pueden ser negativos.");
				return false;
			}
			return true;
		}

		const MOBILE_QUERY = "(max-width: 599px)";
		const infoSlot = section?.querySelector<HTMLElement>("[data-info-slot]");

		// En mobile, la caja de información de cada paso (¿Qué vamos a comparar? / ¿Por qué
		// te preguntamos esto? / ¿Qué comprobamos?) no tiene sentido enterrada debajo del
		// formulario, así que se traslada arriba del todo, justo debajo del disclaimer.
		// En escritorio no se toca: se queda donde está, junto al formulario de cada paso.
		function moveInfoColToSlot(step: number) {
			if (!infoSlot || !window.matchMedia(MOBILE_QUERY).matches) return;
			// Devuelve la caja que estuviera en el slot a su paso de origen.
			const current = infoSlot.querySelector<HTMLElement>(".info-col");
			if (current) {
				const homeStep = current.dataset.homeStep;
				const homeGrid = section?.querySelector<HTMLElement>(`[data-step="${homeStep}"] .step-grid`);
				homeGrid?.appendChild(current);
			}
			const infoCol = section?.querySelector<HTMLElement>(`[data-step="${step}"] .info-col`);
			if (infoCol) {
				infoCol.dataset.homeStep = String(step);
				infoSlot.appendChild(infoCol);
			}
		}

		function goToStep(step: number) {
			currentStep = step;
			stepViews.forEach((view) => {
				view.hidden = Number(view.dataset.step) !== step;
			});
			moveInfoColToSlot(step);
			const meta = stepMeta[step - 1];
			if (stepLabel) stepLabel.textContent = meta.label;
			if (stepPercent) stepPercent.textContent = `${step * 25} % completado`;
			if (progressFill) progressFill.style.width = `${step * 25}%`;
			if (stepSubtitle) stepSubtitle.textContent = meta.subtitle;
			const stepView = section?.querySelector<HTMLElement>(`[data-step="${step}"]`);
			const headings = Array.from(stepView?.querySelectorAll<HTMLElement>("h3") ?? []);
			const heading = headings.find((h) => h.offsetParent !== null) ?? stepView;
			heading?.setAttribute("tabindex", "-1");
			heading?.focus({ preventScroll: true });
		}

		function formatEs(n: number): string {
			return new Intl.NumberFormat("es-ES", { maximumFractionDigits: 0, useGrouping: true }).format(n);
		}

		function renderResultado() {
			if (!section) return;
			const comunidad = (section.querySelector<HTMLSelectElement>("#avs-comunidad"))?.value as Comunidad;
			const content = section.querySelector<HTMLElement>("[data-result-content]");
			const unavailable = section.querySelector<HTMLElement>("[data-result-unavailable]");

			if (!comunidad || !comunidadDisponible(comunidad)) {
				if (content) content.hidden = true;
				if (unavailable) unavailable.hidden = false;
				return;
			}

			const input: EntradaSimulador = {
				comunidad,
				ingresos: parseEsNumber((section.querySelector<HTMLInputElement>("#avs-ingresos"))?.value ?? "") ?? 0,
				gastos: parseEsNumber((section.querySelector<HTMLInputElement>("#avs-gastos"))?.value ?? "") ?? 0,
				otrosIngresos:
					pillGroups["otros-ingresos"] === "si"
						? (parseEsNumber((section.querySelector<HTMLInputElement>("#avs-otros-importe"))?.value ?? "") ?? 0)
						: 0,
				edad: parseEsNumber((section.querySelector<HTMLInputElement>("#avs-edad"))?.value ?? "") ?? 0,
				hijos: Number((section.querySelector<HTMLSelectElement>("#avs-hijos"))?.value ?? "0"),
				hijosMenoresDe3: Number((section.querySelector<HTMLSelectElement>("#avs-hijos-menores-3"))?.value ?? "0"),
				hijoDiscapacidad: pillGroups["hijo-discapacidad"] === "si",
				discapacidad: pillGroups.discapacidad === "si",
				ascendientes: Number((section.querySelector<HTMLSelectElement>("#avs-ascendientes"))?.value ?? "0"),
				dineroPersonal: parseEsNumber((section.querySelector<HTMLInputElement>("#avs-dinero-personal"))?.value ?? "") ?? 0,
				retirada: (pillGroups.retirada || "combinacion") as EntradaSimulador["retirada"],
				costesAdicionales: parseEsNumber((section.querySelector<HTMLInputElement>("#avs-costes"))?.value ?? "") ?? 0,
				tipoReducido: "no",
				tipoImpuestoSociedadesPct: Number((section.querySelector<HTMLSelectElement>("#avs-tipo-is"))?.value ?? "25"),
			};

			const resultado = calcular(input);
			if (!resultado) {
				if (content) content.hidden = true;
				if (unavailable) unavailable.hidden = false;
				return;
			}

			if (content) content.hidden = false;
			if (unavailable) unavailable.hidden = true;

			const setText = (selector: string, value: string) => {
				const el = section.querySelector<HTMLElement>(selector);
				if (el) el.textContent = value;
			};

			setText("[data-result-title]", resultado.tituloResultado);
			setText("[data-result-text]", resultado.textoResultado);

			setText("[data-r-auto-beneficio]", `${formatEs(resultado.autonomo.beneficioAntesImpuestos)} €`);
			setText("[data-r-auto-carga]", `${formatEs(resultado.autonomo.cotizaciones + resultado.autonomo.irpf)} €`);
			setText("[data-r-auto-disponible]", `${formatEs(resultado.autonomo.dineroPersonalDisponible)} €`);

			setText("[data-r-soc-beneficio]", `${formatEs(resultado.sociedad.beneficioAntesImpuestos)} €`);
			setText("[data-r-soc-disponible]", `${formatEs(resultado.sociedad.dineroPersonalDisponible)} €`);
			setText("[data-r-soc-is]", `${formatEs(resultado.sociedad.impuestoSociedades)} €`);
			setText("[data-r-soc-retenido]", `${formatEs(resultado.sociedad.dineroQuePermaneceEnEmpresa ?? 0)} €`);

			const avisoEl = section.querySelector<HTMLElement>("[data-aviso-capacidad]");
			if (avisoEl) avisoEl.hidden = !resultado.sociedad.retiradaSuperaCapacidadSociedad;

			const porqueList = section.querySelector<HTMLElement>("[data-result-porque]");
			if (porqueList) {
				porqueList.innerHTML = "";
				resultado.porQue.forEach((texto) => {
					const li = document.createElement("li");
					li.textContent = texto;
					porqueList.appendChild(li);
				});
			}
		}

		section.querySelectorAll<HTMLButtonElement>("[data-continue]").forEach((btn) => {
			btn.addEventListener("click", () => {
				const from = Number(btn.dataset.continue);
				if (from === 1 && !validateStep1()) return;
				if (from === 2 && !validateStep2()) return;
				if (from === 3 && !validateStep3()) return;
				if (from === 3) {
					renderResultado();
					storeResumen();
				}
				goToStep(from + 1);
			});
		});

		section.querySelectorAll<HTMLButtonElement>("[data-back]").forEach((btn) => {
			btn.addEventListener("click", () => {
				const from = Number(btn.dataset.back);
				goToStep(from - 1);
			});
		});

		section.querySelector<HTMLButtonElement>("[data-modificar]")?.addEventListener("click", () => {
			goToStep(1);
		});

		function storeResumen() {
			try {
				sessionStorage.setItem(
					"autonomoSociedadResumen",
					"He utilizado el simulador Autónomo vs. Sociedad y me gustaría revisar mi situación.",
				);
			} catch {
				/* sessionStorage no disponible: se omite el prellenado del formulario */
			}
		}

		section.querySelector<HTMLAnchorElement>("[data-cta-revision]")?.addEventListener("click", () => {
			storeResumen();
			const field = document.querySelector<HTMLElement>("#contacto [data-simulacion-field]");
			const textarea = document.querySelector<HTMLTextAreaElement>("#contacto #datos-simulacion");
			const resumen = sessionStorage.getItem("autonomoSociedadResumen");
			if (field && textarea && resumen && !textarea.value) {
				textarea.value = resumen;
				field.hidden = false;
			}
		});

		// En mobile, las cajas "¿Qué vamos a comparar?" / "¿Por qué te preguntamos esto?" /
		// "¿Qué comprobamos?" empiezan plegadas para que el formulario quede más a la vista;
		// en escritorio se quedan exactamente igual que siempre, siempre visibles.
		if (window.matchMedia(MOBILE_QUERY).matches) {
			section.querySelectorAll<HTMLButtonElement>("[data-info-toggle]").forEach((toggle) => {
				const body = document.getElementById(toggle.getAttribute("aria-controls") ?? "");
				if (!body) return;
				body.hidden = true;
				toggle.setAttribute("aria-expanded", "false");
				toggle.addEventListener("click", () => {
					const isOpen = toggle.getAttribute("aria-expanded") === "true";
					toggle.setAttribute("aria-expanded", String(!isOpen));
					body.hidden = isOpen;
				});
			});
		}

		goToStep(1);
	}
</script>
