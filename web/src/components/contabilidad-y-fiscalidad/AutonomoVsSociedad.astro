---
---

<section id="simulador" class="avs">
	<div class="wrap">
		<p class="eyebrow">Simulador orientativo</p>
		<h2>¿Autónomo o sociedad?</h2>
		<p class="subtitle" data-step-subtitle>Compara ambos escenarios con los datos básicos de tu actividad.</p>
		<p class="disclaimer">Esta herramienta ofrece una estimación simplificada. No constituye asesoramiento fiscal, contable, laboral o mercantil y no sustituye el estudio de tu situación personal.</p>

		<div class="info-col-mobile-slot" data-info-slot></div>

		<div class="card">
			<div class="top-row">
				<span data-step-label>Paso 1 de 4 · Tu actividad</span>
				<span data-step-percent>25 % completado</span>
			</div>
			<div class="progress-track">
				<div class="progress-fill" data-progress-fill></div>
			</div>

			<!-- Paso 1 — Actividad -->
			<div data-step="1" class="step-view">
				<div class="step-grid">
					<div class="form-col">
						<h3>Cuéntanos cómo funciona tu actividad</h3>

						<div class="field">
							<label for="avs-comunidad">Comunidad autónoma de residencia fiscal</label>
							<select id="avs-comunidad" name="comunidad" aria-describedby="avs-comunidad-help">
								<option value="" selected disabled>Selecciona una comunidad</option>
								<option value="andalucia">Andalucía</option>
								<option value="aragon">Aragón</option>
								<option value="asturias">Principado de Asturias</option>
								<option value="baleares">Illes Balears</option>
								<option value="canarias">Canarias</option>
								<option value="cantabria">Cantabria</option>
								<option value="castilla-la-mancha">Castilla-La Mancha</option>
								<option value="castilla-y-leon">Castilla y León</option>
								<option value="cataluna">Cataluña</option>
								<option value="ceuta">Ceuta</option>
								<option value="extremadura">Extremadura</option>
								<option value="galicia">Galicia</option>
								<option value="madrid">Comunidad de Madrid</option>
								<option value="melilla">Melilla</option>
								<option value="murcia">Región de Murcia</option>
								<option value="la-rioja">La Rioja</option>
								<option value="valencia">Comunitat Valenciana</option>
								<option value="navarra" disabled>Comunidad Foral de Navarra (próximamente)</option>
								<option value="pais-vasco" disabled>País Vasco (próximamente)</option>
							</select>
							<p class="field-help" id="avs-comunidad-help">Necesaria para calcular correctamente el tramo autonómico del IRPF.</p>
						</div>

						<div class="field">
							<label for="avs-ingresos">Facturación anual</label>
							<input type="text" inputmode="decimal" id="avs-ingresos" placeholder="80.000 €" autocomplete="off" aria-describedby="avs-ingresos-help" />
							<p class="field-help" id="avs-ingresos-help">Importe anual aproximado, sin IVA.</p>
						</div>

						<div class="field">
							<label for="avs-gastos">Gastos deducibles anuales</label>
							<input type="text" inputmode="decimal" id="avs-gastos" placeholder="25.000 €" autocomplete="off" aria-describedby="avs-gastos-help" />
							<p class="field-help" id="avs-gastos-help">Gastos necesarios para la actividad, sin impuestos ni cuota de autónomos.</p>
						</div>

						<div class="field">
							<span class="toggle-label" id="avs-otros-label">¿Recibes otros ingresos personales?</span>
							<div class="pill-toggle" role="group" aria-labelledby="avs-otros-label" data-toggle="otros-ingresos">
								<button type="button" class="pill-btn" data-value="no" aria-pressed="true">No</button>
								<button type="button" class="pill-btn" data-value="si" aria-pressed="false">Sí</button>
							</div>
						</div>

						<div class="field" data-otros-ingresos-importe hidden>
							<label for="avs-otros-importe">Importe bruto anual aproximado</label>
							<input type="text" inputmode="decimal" id="avs-otros-importe" placeholder="0 €" autocomplete="off" />
						</div>

						<p class="form-error" data-error="1" role="alert" hidden></p>
					</div>

					<div class="info-col">
						<button type="button" class="info-toggle" data-info-toggle aria-expanded="true" aria-controls="avs-info-1">
							¿Qué vamos a comparar?
							<svg class="info-toggle-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
						</button>
						<div class="info-body" id="avs-info-1" data-info-body>
							<ul class="info-list">
								<li><span class="info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path><path d="M9 17l6-6"></path><circle cx="9.5" cy="10.5" r="0.6" fill="currentColor"></circle><circle cx="14.5" cy="15.5" r="0.6" fill="currentColor"></circle></svg></span>Impuestos y cotizaciones</li>
								<li><span class="info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V7l7-4 7 4v14"></path><path d="M3 21h18"></path><path d="M9 9h1"></path><path d="M14 9h1"></path><path d="M9 13h1"></path><path d="M14 13h1"></path><path d="M9 17h1"></path><path d="M14 17h1"></path></svg></span>Costes de mantener una sociedad</li>
								<li><span class="info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 4-6 8-6s8 2 8 6"></path></svg></span>Dinero disponible para ti</li>
								<li><span class="info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h12a1 1 0 0 1 1 1v3"></path><path d="M3 7v11a2 2 0 0 0 2 2h14a1 1 0 0 0 1-1v-5a1 1 0 0 0-1-1h-4a2 2 0 0 0 0 4h5"></path></svg></span>Dinero que permanecería en la empresa</li>
							</ul>
							<p class="info-note"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 8h.01"></path><path d="M11 11.5h1v4.5h1"></path></svg>El resultado será orientativo y no sustituye una revisión profesional.</p>
						</div>
					</div>
				</div>

				<div class="bottom-row">
					<p class="privacy-note"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>Tus datos no se guardan.</p>
					<div class="nav-buttons">
						<button type="button" class="btn-continue" data-continue="1">Continuar <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></button>
					</div>
				</div>
			</div>

			<!-- Paso 2 — Situación personal -->
			<div data-step="2" class="step-view" hidden>
				<div class="step-grid">
					<div class="form-col">
						<h3>Cuéntanos tu situación personal</h3>

						<div class="field-row">
							<div class="field">
								<label for="avs-edad">Edad</label>
								<input type="text" inputmode="numeric" id="avs-edad" placeholder="42 años" autocomplete="off" />
							</div>
							<div class="field">
								<label for="avs-civil">Estado civil</label>
								<select id="avs-civil">
									<option value="" selected disabled>Selecciona una opción</option>
									<option value="soltero">Soltero/a</option>
									<option value="casado">Casado/a</option>
									<option value="pareja-hecho">Pareja de hecho</option>
									<option value="separado">Separado/a o divorciado/a</option>
									<option value="viudo">Viudo/a</option>
								</select>
							</div>
						</div>

						<div class="field-row">
							<div class="field">
								<label for="avs-hijos">Número de hijos</label>
								<select id="avs-hijos">
									<option value="0" selected>0</option>
									<option value="1">1</option>
									<option value="2">2</option>
									<option value="3">3</option>
									<option value="4">4</option>
									<option value="5">5 o más</option>
								</select>
							</div>
							<div class="field" data-edades-hijos hidden>
								<label for="avs-hijos-menores-3">¿Cuántos de tus hijos son menores de 3 años?</label>
								<select id="avs-hijos-menores-3" aria-describedby="avs-hijos-menores-3-help">
									<option value="0" selected>0</option>
									<option value="1">1</option>
									<option value="2">2</option>
									<option value="3">3</option>
									<option value="4">4</option>
									<option value="5">5</option>
								</select>
								<p class="field-help" id="avs-hijos-menores-3-help">Da derecho a un mínimo familiar adicional.</p>
							</div>
						</div>

						<div class="field-row">
							<div class="field" data-hijo-discapacidad hidden>
								<span class="toggle-label" id="avs-hijo-discapacidad-label">¿Algún hijo tiene discapacidad?</span>
								<div class="pill-toggle" role="group" aria-labelledby="avs-hijo-discapacidad-label" data-toggle="hijo-discapacidad">
									<button type="button" class="pill-btn" data-value="no" aria-pressed="true">No</button>
									<button type="button" class="pill-btn" data-value="si" aria-pressed="false">Sí</button>
								</div>
							</div>
							<div class="field">
								<span class="toggle-label" id="avs-discapacidad-label">¿Tienes una discapacidad reconocida?</span>
								<div class="pill-toggle" role="group" aria-labelledby="avs-discapacidad-label" data-toggle="discapacidad">
									<button type="button" class="pill-btn" data-value="no" aria-pressed="true">No</button>
									<button type="button" class="pill-btn" data-value="si" aria-pressed="false">Sí</button>
								</div>
							</div>
						</div>

						<div class="field-row">
							<div class="field">
								<label for="avs-ascendientes">Ascendientes a cargo</label>
								<select id="avs-ascendientes" aria-describedby="avs-ascendientes-help">
									<option value="0" selected>0</option>
									<option value="1">1</option>
									<option value="2">2</option>
									<option value="3">3 o más</option>
								</select>
								<p class="field-help" id="avs-ascendientes-help">Padres, abuelos u otros familiares.</p>
							</div>
							<div class="field">
								<span class="toggle-label" id="avs-declaracion-label">Tipo de declaración</span>
								<div class="pill-toggle" role="group" aria-labelledby="avs-declaracion-label" data-toggle="declaracion">
									<button type="button" class="pill-btn" data-value="individual" aria-pressed="true">Individual</button>
									<button type="button" class="pill-btn" data-value="conjunta" aria-pressed="false">Conjunta</button>
								</div>
								<p class="field-help">Elige cómo presentarás tu declaración de la renta.</p>
							</div>
						</div>

						<div class="field">
							<label for="avs-dinero-personal">Dinero que necesitas para uso personal al año</label>
							<input type="text" inputmode="decimal" id="avs-dinero-personal" placeholder="36.000 €" autocomplete="off" aria-describedby="avs-dinero-personal-help" />
							<p class="field-help" id="avs-dinero-personal-help">Cantidad aproximada para tu estilo de vida.</p>
						</div>

						<p class="form-error" data-error="2" role="alert" hidden></p>
					</div>

					<div class="info-col">
						<button type="button" class="info-toggle" data-info-toggle aria-expanded="true" aria-controls="avs-info-2">
							¿Por qué te preguntamos esto?
							<svg class="info-toggle-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
						</button>
						<div class="info-body" id="avs-info-2" data-info-body>
							<ul class="info-list">
								<li><span class="info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path><path d="M9 17l6-6"></path></svg></span>Aproximar el IRPF</li>
								<li><span class="info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"></circle><path d="M2 20c0-3.3 3-5 7-5s7 1.7 7 5"></path><path d="M17 8a3 3 0 1 1 0 6"></path><path d="M22 20c0-2.7-1.8-4.2-4-4.7"></path></svg></span>Aplicar mínimos personales y familiares</li>
								<li><span class="info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="9" r="3"></circle><circle cx="17" cy="9" r="3"></circle><path d="M3 19c0-3 2.5-4.5 6-4.5s6 1.5 6 4.5"></path></svg></span>Comparar declaración individual o conjunta</li>
								<li><span class="info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h12a1 1 0 0 1 1 1v3"></path><path d="M3 7v11a2 2 0 0 0 2 2h14a1 1 0 0 0 1-1v-5a1 1 0 0 0-1-1h-4a2 2 0 0 0 0 4h5"></path></svg></span>Calcular el dinero disponible para ti</li>
							</ul>
							<p class="info-note"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 8h.01"></path><path d="M11 11.5h1v4.5h1"></path></svg>Solo pedimos los datos necesarios para realizar la estimación.</p>
						</div>
					</div>
				</div>

				<div class="bottom-row">
					<p class="privacy-note"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>Tus datos no se guardan.</p>
					<div class="nav-buttons">
						<button type="button" class="btn-back" data-back="2">Volver</button>
						<button type="button" class="btn-continue" data-continue="2">Continuar <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></button>
					</div>
				</div>
			</div>

			<!-- Paso 3 — Sociedad -->
			<div data-step="3" class="step-view" hidden>
				<div class="step-grid">
					<div class="form-col">
						<h3>Configura el escenario de sociedad</h3>

						<div class="field">
							<span class="toggle-label" id="avs-retirada-label">¿Cómo retirarías el dinero?</span>
							<div class="pill-toggle pill-toggle-3" role="group" aria-labelledby="avs-retirada-label" data-toggle="retirada">
								<button type="button" class="pill-btn" data-value="retribucion" aria-pressed="false">Retribución</button>
								<button type="button" class="pill-btn" data-value="dividendos" aria-pressed="false">Dividendos</button>
								<button type="button" class="pill-btn" data-value="combinacion" aria-pressed="false">Combinación</button>
							</div>
						</div>

						<div class="field">
							<label for="avs-tipo-is">Tipo del Impuesto sobre Sociedades</label>
							<select id="avs-tipo-is" aria-describedby="avs-tipo-is-help">
								<option value="" selected disabled>Selecciona un tipo</option>
								<option value="15">15 %</option>
								<option value="20">20 %</option>
								<option value="23">23 %</option>
								<option value="25">25 %</option>
							</select>
							<p class="field-help" id="avs-tipo-is-help">
								Si no sabes cuál te corresponde, selecciona el 25 %. Durante el asesoramiento
								revisaremos si puedes aplicar un tipo inferior.
							</p>
						</div>

						<div class="field">
							<label for="avs-costes">Costes adicionales por tener una sociedad</label>
							<input type="text" inputmode="decimal" id="avs-costes" placeholder="3.000 €" autocomplete="off" aria-describedby="avs-costes-help" />
							<p class="field-help" id="avs-costes-help">
								Incluye únicamente los costes derivados de la forma jurídica (Registro Mercantil,
								depósito de cuentas, certificado digital y otras obligaciones mercantiles). No
								incluyas los gastos de la actividad, ya que se han introducido anteriormente como
								gastos deducibles.
							</p>
						</div>

						<p class="form-error" data-error="3" role="alert" hidden></p>
					</div>

					<div class="info-col">
						<button type="button" class="info-toggle" data-info-toggle aria-expanded="true" aria-controls="avs-info-3">
							¿Qué comprobamos?
							<svg class="info-toggle-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
						</button>
						<div class="info-body" id="avs-info-3" data-info-body>
							<ul class="info-list">
								<li><span class="info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h12a1 1 0 0 1 1 1v3"></path><path d="M3 7v11a2 2 0 0 0 2 2h14a1 1 0 0 0 1-1v-5a1 1 0 0 0-1-1h-4a2 2 0 0 0 0 4h5"></path></svg></span>Cómo recibirías el dinero</li>
								<li><span class="info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V7l7-4 7 4v14"></path><path d="M3 21h18"></path></svg></span>Costes de mantener la sociedad</li>
								<li><span class="info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg></span>Beneficio que quedaría en la empresa</li>
								<li><span class="info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v4H4z"></path><path d="M4 4l8 8 8-8"></path></svg></span>El tipo del Impuesto sobre Sociedades que aplicarías</li>
							</ul>
							<p class="info-note"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 8h.01"></path><path d="M11 11.5h1v4.5h1"></path></svg>Si no conoces tu tipo exacto, indica el 25 % — lo revisaremos contigo durante el asesoramiento.</p>
						</div>
					</div>
				</div>

				<div class="bottom-row">
					<p class="privacy-note"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>Tus datos no se guardan.</p>
					<div class="nav-buttons">
						<button type="button" class="btn-back" data-back="3">Volver</button>
						<button type="button" class="btn-continue" data-continue="3">Ver resultado <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></button>
					</div>
				</div>
			</div>

			<!-- Paso 4 — Resultado -->
			<div data-step="4" class="step-view" hidden>
				<p class="draft-warning">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4"></path><path d="M12 17h.01"></path><path d="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path></svg>
					Este resultado es una estimación orientativa. Para un cálculo preciso adaptado a tu situación,
					contacta con nosotros.
				</p>

				<div data-result-content>
					<div class="result-headline">
						<p class="result-headline-title" data-result-title></p>
						<p class="result-headline-text" data-result-text></p>
					</div>

					<p class="aviso-capacidad" data-aviso-capacidad hidden>
						Con estos datos, la sociedad no genera beneficio suficiente para cubrir toda la retirada
						solicitada. No quedaría dinero disponible dentro de la empresa.
					</p>

					<div class="result-columns">
						<div class="result-card">
							<h4>Autónomo</h4>
							<div class="result-row"><span>Beneficio de la actividad</span><strong data-r-auto-beneficio></strong></div>
							<div class="result-row"><span>Impuestos y cotizaciones</span><strong data-r-auto-carga></strong></div>
