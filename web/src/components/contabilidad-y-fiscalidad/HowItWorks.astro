---
const options = [
	{
		title: "Servicio periódico",
		text: "Gestión contable y fiscal de forma recurrente para atender operaciones, declaraciones y obligaciones del ejercicio.",
	},
	{
		title: "Servicio independiente",
		text: "Contratación de únicamente la contabilidad o únicamente la fiscalidad cuando ya se dispone de la otra parte cubierta.",
	},
	{
		title: "Revisión puntual",
		text: "Un trabajo concreto para revisar la situación existente, detectar incidencias o valorar posibles mejoras.",
	},
];
---

<section class="how">
	<div class="wrap">
		<h2>Cómo puede organizarse el servicio</h2>
		<div class="grid">
			{options.map((option) => (
				<div class="card">
					<h4>{option.title}</h4>
					<p>{option.text}</p>
				</div>
			))}
		</div>
		<p class="note">
			La periodicidad, el alcance y el nivel de acompañamiento se establecen según las necesidades
			reales de cada cliente.
		</p>
	</div>
</section>

<style>
	.how {
		padding: 88px 24px;
		background: var(--color-bg);
	}

	.wrap {
		max-width: 1180px;
		margin: 0 auto;
	}

	h2 {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: clamp(24px, 3.2vw, 34px);
		text-align: center;
		color: var(--color-text);
		margin: 0 0 48px;
	}

	.grid {
		display: grid;
		gap: 18px;
	}

	.card {
		background: var(--color-surface);
		border-radius: 16px;
		padding: 26px 24px;
	}

	.card h4 {
		margin: 0 0 10px;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 17px;
		color: var(--color-text);
	}

	.card p {
		margin: 0;
		font-family: var(--font-body);
		font-size: 14.5px;
		line-height: 1.6;
		color: var(--color-muted);
	}

	.note {
		margin: 28px 0 0;
		text-align: center;
		font-family: var(--font-body);
		font-size: 13.5px;
		font-style: italic;
		color: var(--color-muted);
	}

	@media (min-width: 700px) {
		.grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (max-width: 599px) {
		.how {
			padding: 25px 15px;
		}
	}
</style>
