---
---

<section id="simulador-simplificado" class="avss">
	<div class="wrap">
		<p class="eyebrow">Simulador orientativo</p>
		<h2>¿Autónomo o sociedad? Primera orientación</h2>
		<p class="subtitle">Una estimación rápida con 3 datos, sin entrar en tu situación personal.</p>
		<p class="disclaimer">
			Esta herramienta ofrece una orientación general, no una cifra cerrada. No constituye
			asesoramiento fiscal, contable, laboral o mercantil y no sustituye el estudio de tu situación
			personal.
		</p>

		<div class="draft-warning">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"></path>
				<line x1="12" y1="9" x2="12" y2="13"></line>
				<line x1="12" y1="17" x2="12.01" y2="17"></line>
			</svg>
			Este cálculo usa una configuración fiscal en borrador (ejercicio 2025), todavía sin la
			revisión completa del área fiscal de Perucha y Asociados. No debe considerarse un resultado
			definitivo.
		</div>

		<div class="card">
			<div data-view="form">
				<div class="field">
					<label for="avss-comunidad">Comunidad autónoma de residencia fiscal</label>
					<select id="avss-comunidad" name="comunidad" aria-describedby="avss-comunidad-help">
						<option value="" selected disabled>Selecciona una comunidad</option>
						<option value="andalucia">Andalucía</option>
						<option value="aragon">Aragón</option>
						<option value="asturias">Principado de Asturias</option>
						<option value="baleares">Illes Balears</option>
						<option value="canarias">Canarias</option>
						<option value="cantabria">Cantabria</option>
						<option value="castilla-la-mancha">Castilla-La Mancha</option>
						<option value="castilla-y-leon">Castilla y León</option>
						<option value="cataluna">Cataluña</option>
						<option value="ceuta">Ceuta</option>
						<option value="extremadura">Extremadura</option>
						<option value="galicia">Galicia</option>
						<option value="madrid">Comunidad de Madrid</option>
						<option value="melilla">Melilla</option>
						<option value="murcia">Región de Murcia</option>
						<option value="la-rioja">La Rioja</option>
						<option value="valencia">Comunitat Valenciana</option>
						<option value="navarra" disabled>Comunidad Foral de Navarra (próximamente)</option>
						<option value="pais-vasco" disabled>País Vasco (próximamente)</option>
					</select>
					<p class="field-help" id="avss-comunidad-help">Necesaria para el tramo autonómico del IRPF.</p>
				</div>

				<div class="field">
					<label for="avss-beneficio">Beneficio anual aproximado de la actividad</label>
					<input type="text" inputmode="decimal" id="avss-beneficio" placeholder="40.000 €" autocomplete="off" aria-describedby="avss-beneficio-help" />
					<p class="field-help" id="avss-beneficio-help">Ingresos menos gastos, aproximado, sin IVA.</p>
				</div>

				<div class="field">
					<label for="avss-retirada">Dinero que necesitarías retirar cada año para uso personal</label>
					<input type="text" inputmode="decimal" id="avss-retirada" placeholder="24.000 €" autocomplete="off" aria-describedby="avss-retirada-help" />
					<p class="field-help" id="avss-retirada-help">Lo que necesitas llevarte a tu bolsillo, no el beneficio total.</p>
				</div>

				<p class="form-error" data-error hidden></p>

				<button type="button" class="btn-continue" data-calcular>Ver estimación orientativa</button>
			</div>

			<div data-view="result" hidden>
				<div class="result-headline">
					<h3 data-result-title></h3>
					<p data-result-text></p>
				</div>

				<div class="result-columns">
					<div class="result-card">
						<h4>Autónomo</h4>
						<p class="result-range" data-result-autonomo></p>
						<p class="result-caption">dinero disponible al año, orientativo</p>
					</div>
					<div class="result-card">
						<h4>Sociedad</h4>
						<p class="result-range" data-result-sociedad></p>
						<p class="result-caption">dinero disponible al año, orientativo</p>
					</div>
				</div>

				<div class="factores">
					<h4>Factores que podrían cambiar este resultado</h4>
					<ul>
						<li>Tu situación familiar (hijos, cónyuge, ascendientes a cargo)</li>
						<li>Otros ingresos personales que tengas, además de la actividad</li>
						<li>Cómo retirarías el dinero de la sociedad (nómina, dividendos o una combinación)</li>
						<li>Los costes reales de gestoría y administración de mantener una sociedad</li>
						<li>Si la sociedad pudiera acogerse a algún tipo reducido del Impuesto sobre Sociedades</li>
					</ul>
				</div>

				<p class="recomendacion" data-recomendacion></p>

				<div class="bottom-row">
					<button type="button" class="btn-back" data-modificar>Modificar datos</button>
					<a href="#contacto" class="btn-continue" data-cta-revision>Solicitar revisión profesional</a>
				</div>

				<p class="legal-note">
					Resultado orientativo y no vinculante, calculado sin conocer tu situación personal y
					familiar completa. No sustituye un estudio fiscal personalizado.
				</p>
			</div>
		</div>
	</div>
</section>

<style>
	.avss {
		padding: 96px 24px;
		background: var(--color-surface);
	}

	.wrap {
		max-width: 640px;
		margin: 0 auto;
	}

	.eyebrow {
		font-family: var(--font-body);
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-accent);
		text-align: center;
		margin: 0 0 12px;
	}

	h2 {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: clamp(26px, 3.6vw, 38px);
		text-align: center;
		color: var(--color-text);
		margin: 0 0 12px;
	}

	.subtitle {
		font-family: var(--font-body);
		font-size: 16px;
		color: var(--color-muted);
		text-align: center;
		margin: 0 0 16px;
	}

	.disclaimer {
		font-family: var(--font-body);
		font-size: 13px;
		font-style: italic;
		color: var(--color-muted);
		text-align: center;
		max-width: 520px;
		margin: 0 auto 24px;
	}

	.draft-warning {
		display: flex;
		align-items: flex-start;
		gap: 10px;
		background: #fff7ed;
		border: 1px solid #fed7aa;
		color: #9a3412;
		border-radius: 12px;
		padding: 14px 16px;
		font-family: var(--font-body);
		font-size: 13.5px;
		line-height: 1.5;
		margin: 0 0 28px;
	}

	.draft-warning svg {
		flex: 0 0 auto;
		margin-top: 1px;
	}

	.card {
		background: #fff;
		border: 1px solid var(--color-divider);
		border-radius: 22px;
		padding: 32px;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 7px;
		margin: 0 0 18px;
	}

	.field label {
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 14px;
		color: var(--color-text);
	}

	.field-help {
		font-family: var(--font-body);
		font-size: 12.5px;
		color: var(--color-muted);
		margin: 0;
	}

	.field input,
	.field select {
		background: var(--color-bg);
		border: 1px solid var(--color-divider);
		border-radius: 10px;
		padding: 12px 14px;
		font-family: var(--font-body);
		font-size: 15px;
		color: var(--color-text);
		outline: none;
	}

	.field input:focus,
	.field select:focus {
		border-color: var(--color-accent);
	}

	.form-error {
		color: #b91c1c;
		font-family: var(--font-body);
		font-size: 13.5px;
		margin: 0 0 16px;
	}

	.btn-continue {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 15px;
		border-radius: 999px;
		padding: 13px 24px;
		background: var(--color-accent-900);
		border: 1.5px solid var(--color-accent-900);
		color: #fff;
		cursor: pointer;
		text-align: center;
		text-decoration: none;
	}

	.btn-continue:hover {
		background: var(--color-accent-800);
	}

	.btn-back {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 15px;
		border-radius: 999px;
		padding: 13px 24px;
		background: transparent;
		border: 1.5px solid var(--color-divider);
		color: var(--color-text);
		cursor: pointer;
	}

	.btn-back:hover {
		border-color: var(--color-accent-300);
	}

	.result-headline {
		margin: 0 0 24px;
	}

	.result-headline h3 {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 22px;
		color: var(--color-text);
		margin: 0 0 8px;
	}

	.result-headline p {
		font-family: var(--font-body);
		font-size: 14.5px;
		color: var(--color-muted);
		line-height: 1.55;
		margin: 0;
	}

	.result-columns {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
		margin: 0 0 24px;
	}

	.result-card {
		background: var(--color-accent-100);
		border-radius: 14px;
		padding: 18px;
	}

	.result-card h4 {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 14px;
		color: var(--color-accent-800);
		margin: 0 0 6px;
	}

	.result-range {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 18px;
		color: var(--color-text);
		margin: 0 0 2px;
	}

	.result-caption {
		font-family: var(--font-body);
		font-size: 11.5px;
		color: var(--color-muted);
		margin: 0;
	}

	.factores {
		background: var(--color-bg);
		border-radius: 14px;
		padding: 18px 20px;
		margin: 0 0 20px;
	}

	.factores h4 {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 14px;
		color: var(--color-text);
		margin: 0 0 10px;
	}

	.factores ul {
		margin: 0;
		padding-left: 18px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.factores li {
		font-family: var(--font-body);
		font-size: 13.5px;
		color: var(--color-muted);
		line-height: 1.5;
	}

	.recomendacion {
		font-family: var(--font-body);
		font-size: 14.5px;
		color: var(--color-text);
		background: var(--color-accent-200);
		border-radius: 12px;
		padding: 14px 16px;
		margin: 0 0 24px;
	}

	.bottom-row {
		display: flex;
		flex-direction: column-reverse;
		gap: 12px;
		margin: 0 0 20px;
	}

	.legal-note {
		font-family: var(--font-body);
		font-size: 12px;
		color: var(--color-muted);
		line-height: 1.5;
		margin: 0;
	}

	@media (min-width: 560px) {
		.bottom-row {
			flex-direction: row;
			justify-content: space-between;
		}

		.bottom-row .btn-continue,
		.bottom-row .btn-back {
			width: auto;
		}
	}
</style>

<script>
	import { calcular, comunidadDisponible, type Comunidad, type EntradaSimulador } from "../../lib/fiscal/motorAutonomoVsSociedad";

	// Margen orientativo aplicado al resultado del motor para presentar un intervalo en vez de una
	// cifra cerrada, ya que esta versión no pregunta situación familiar, otros ingresos ni forma de
	// retirada exacta. No es un cálculo de "mejor/peor caso" real, es un margen fijo de incertidumbre.
	const MARGEN_INTERVALO = 0.15;

	function initSimuladorSimplificado() {
		const section = document.querySelector<HTMLElement>("#simulador-simplificado.avss");
		if (!section) return;

		const formView = section.querySelector<HTMLElement>('[data-view="form"]');
		const resultView = section.querySelector<HTMLElement>('[data-view="result"]');
		const comunidadEl = section.querySelector<HTMLSelectElement>("#avss-comunidad");
		const beneficioEl = section.querySelector<HTMLInputElement>("#avss-beneficio");
		const retiradaEl = section.querySelector<HTMLInputElement>("#avss-retirada");
		const errorEl = section.querySelector<HTMLElement>("[data-error]");

		function parseEsNumber(raw: string): number | null {
			let s = raw.trim().replace(/€/g, "").replace(/\s/g, "");
			if (!s) return null;
			const hasComma = s.includes(",");
			const hasDot = s.includes(".");
			if (hasComma && hasDot) {
				s = s.replace(/\./g, "").replace(",", ".");
			} else if (hasComma) {
				s = s.replace(",", ".");
			} else if (hasDot) {
				const parts = s.split(".");
				const lastPart = parts[parts.length - 1];
				if (parts.length > 1 && lastPart.length === 3) {
					s = parts.join("");
				}
			}
			const n = Number(s);
			return Number.isFinite(n) ? n : null;
		}

		function formatEs(n: number): string {
			return new Intl.NumberFormat("es-ES", { maximumFractionDigits: 0, useGrouping: true }).format(n);
		}

		function showError(message: string) {
			if (!errorEl) return;
			errorEl.textContent = message;
			errorEl.hidden = false;
		}

		function clearError() {
			if (!errorEl) return;
			errorEl.hidden = true;
		}

		section.querySelector<HTMLButtonElement>("[data-calcular]")?.addEventListener("click", () => {
			clearError();

			const comunidad = (comunidadEl?.value || "") as Comunidad;
			const beneficio = parseEsNumber(beneficioEl?.value || "");
			const dineroPersonal = parseEsNumber(retiradaEl?.value || "");

			if (!comunidad) {
				showError("Selecciona tu comunidad autónoma.");
				return;
			}
			if (!comunidadDisponible(comunidad)) {
				showError("Tu comunidad todavía no tiene configuración fiscal disponible en este simulador.");
				return;
			}
			if (beneficio === null || beneficio <= 0) {
				showError("Indica un beneficio anual aproximado mayor que 0.");
				return;
			}
			if (dineroPersonal === null || dineroPersonal < 0) {
				showError("Indica cuánto necesitarías retirar al año (puede ser 0).");
				return;
			}
			if (dineroPersonal > beneficio) {
				showError("El dinero a retirar no puede ser mayor que el beneficio anual.");
				return;
			}

			const input: EntradaSimulador = {
				comunidad,
				ingresos: beneficio,
				gastos: 0,
				otrosIngresos: 0,
				edad: 40,
				hijos: 0,
				hijoDiscapacidad: false,
				discapacidad: false,
				ascendientes: 0,
				dineroPersonal,
				retirada: "combinacion",
				costesAdicionales: 0,
				tipoReducido: "no",
			};

			const resultado = calcular(input);
			if (!resultado || !resultado.comunidadDisponible) {
				showError("No se ha podido calcular una estimación para estos datos.");
				return;
			}

			renderResultado(resultado.autonomo.dineroPersonalDisponible, resultado.sociedad.dineroPersonalDisponible, resultado.tipoResultado);

			if (formView) formView.hidden = true;
			if (resultView) resultView.hidden = false;
			resultView?.scrollIntoView({ behavior: "smooth", block: "start" });
		});

		function renderResultado(disponibleAutonomo: number, disponibleSociedad: number, tipoResultado: 1 | 2 | 3) {
			const autonomoLow = Math.max(0, disponibleAutonomo * (1 - MARGEN_INTERVALO));
			const autonomoHigh = disponibleAutonomo * (1 + MARGEN_INTERVALO);
			const sociedadLow = Math.max(0, disponibleSociedad * (1 - MARGEN_INTERVALO));
			const sociedadHigh = disponibleSociedad * (1 + MARGEN_INTERVALO);

			const autonomoEl = section?.querySelector<HTMLElement>("[data-result-autonomo]");
			const sociedadEl = section?.querySelector<HTMLElement>("[data-result-sociedad]");
			if (autonomoEl) autonomoEl.textContent = `${formatEs(autonomoLow)} € – ${formatEs(autonomoHigh)} €`;
			if (sociedadEl) sociedadEl.textContent = `${formatEs(sociedadLow)} € – ${formatEs(sociedadHigh)} €`;

			const titleEl = section?.querySelector<HTMLElement>("[data-result-title]");
			const textEl = section?.querySelector<HTMLElement>("[data-result-text]");
			const recomendacionEl = section?.querySelector<HTMLElement>("[data-recomendacion]");

			if (tipoResultado === 3) {
				if (titleEl) titleEl.textContent = "No hay una diferencia clara entre las dos opciones";
				if (textEl) textEl.textContent = "Con estos datos, los dos escenarios quedan próximos entre sí.";
				if (recomendacionEl)
					recomendacionEl.textContent =
						"La diferencia orientativa es pequeña. Probablemente no cambie mucho aunque completes más datos, pero la decisión depende también de otros factores no fiscales.";
			} else if (tipoResultado === 2) {
				if (titleEl) titleEl.textContent = "La sociedad podría merecer un estudio más detallado";
				if (textEl) textEl.textContent = "Con estos datos, el escenario de sociedad sale orientativamente por delante.";
				if (recomendacionEl)
					recomendacionEl.textContent =
						"Hay una diferencia orientativa relevante. Te recomendamos completar el análisis con tu situación personal, o pedir una revisión profesional, antes de decidir.";
			} else {
				if (titleEl) titleEl.textContent = "Continuar como autónomo podría ser la opción más sencilla";
				if (textEl) textEl.textContent = "Con estos datos, el escenario de autónomo sale orientativamente por delante.";
				if (recomendacionEl)
					recomendacionEl.textContent =
						"Hay una diferencia orientativa relevante. Te recomendamos completar el análisis con tu situación personal, o pedir una revisión profesional, antes de decidir.";
			}
		}

		section.querySelector<HTMLButtonElement>("[data-modificar]")?.addEventListener("click", () => {
			if (formView) formView.hidden = false;
			if (resultView) resultView.hidden = true;
			formView?.scrollIntoView({ behavior: "smooth", block: "start" });
		});

		section.querySelector<HTMLAnchorElement>("[data-cta-revision]")?.addEventListener("click", () => {
			try {
				sessionStorage.setItem(
					"autonomoSociedadSimplificadoResumen",
					"He utilizado la orientación rápida de Autónomo vs. Sociedad y me gustaría revisar mi situación.",
				);
			} catch {
				/* sessionStorage no disponible: se omite el prellenado del formulario */
			}
			const field = document.querySelector<HTMLElement>("#contacto [data-simulacion-field]");
			const textarea = document.querySelector<HTMLTextAreaElement>("#contacto #datos-simulacion");
			const resumen = sessionStorage.getItem("autonomoSociedadSimplificadoResumen");
			if (field && textarea && resumen && !textarea.value) {
				textarea.value = resumen;
				field.hidden = false;
			}
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initSimuladorSimplificado);
	} else {
		initSimuladorSimplificado();
	}
</script>
