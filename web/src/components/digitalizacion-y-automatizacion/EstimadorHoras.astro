---
---

<section id="simulador" class="estimador">
	<div class="wrap">
		<p class="eyebrow">Estimador de automatización</p>
		<h2>¿Cuánto tiempo podría recuperar tu equipo?</h2>
		<p class="subtitle">Analiza una tarea manual y repetitiva para estimar cuánto tiempo podría liberarse al automatizar parte del proceso.</p>

		<div class="card">
			<p class="step-caption" data-step-caption>Paso 1 de 3 · La tarea</p>
			<div class="stepper" data-stepper>
				<div class="stepper-item" data-stepper-item="1">
					<span class="stepper-circle" data-stepper-circle>1</span>
					<span class="stepper-label">La tarea</span>
				</div>
				<div class="stepper-line" data-stepper-line="1"></div>
				<div class="stepper-item" data-stepper-item="2">
					<span class="stepper-circle" data-stepper-circle>2</span>
					<span class="stepper-label">Tiempo y frecuencia</span>
				</div>
				<div class="stepper-line" data-stepper-line="2"></div>
				<div class="stepper-item" data-stepper-item="3">
					<span class="stepper-circle" data-stepper-circle>3</span>
					<span class="stepper-label">Automatización</span>
				</div>
			</div>

			<!-- Paso 1 — La tarea -->
			<div data-step="1" class="step-view">
				<div class="step-grid">
					<div class="form-col">
						<h3>Cuéntanos qué tarea quieres analizar</h3>

						<div class="field">
							<label for="est-tipo">¿Qué tarea repetitiva quieres analizar?</label>
							<select id="est-tipo">
								<option value="" selected disabled>Selecciona un tipo de tarea</option>
								<option value="datos">Introducción o traslado de datos</option>
								<option value="documentos">Generación o envío de documentos</option>
								<option value="informes">Preparación de informes</option>
								<option value="avisos">Avisos o notificaciones</option>
								<option value="formularios">Tratamiento de formularios</option>
								<option value="archivos">Organización de archivos</option>
								<option value="registros">Actualización de registros</option>
								<option value="intercambio">Intercambio de información entre herramientas</option>
								<option value="otro">Otro proceso administrativo</option>
							</select>
						</div>

						<div class="field">
							<label for="est-personas">¿Cuántas personas realizan esta tarea?</label>
							<div class="field-unit">
								<input type="text" inputmode="numeric" id="est-personas" placeholder="Ej. 3" autocomplete="off" />
								<span class="unit">personas</span>
							</div>
							<p class="field-help">Incluye solo a quienes dedican tiempo directo a completar o revisar la tarea.</p>
						</div>

						<div class="field">
							<label for="est-descripcion">Describe brevemente la tarea (opcional)</label>
							<textarea id="est-descripcion" rows="3" placeholder="Ej. Copiar los pedidos recibidos por correo al programa de gestión."></textarea>
						</div>

						<p class="form-error" data-error="1" role="alert" hidden></p>
					</div>

					<div class="info-col">
						<h4>¿Qué vamos a calcular?</h4>
						<ul class="info-list">
							<li><span class="info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg></span>Tiempo manual actual</li>
							<li><span class="info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"></path><path d="M3 4v5h5"></path><path d="M12 7v5l3 2"></path></svg></span>Horas que podrían recuperarse</li>
							<li><span class="info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 4-6 8-6s8 2 8 6"></path></svg></span>Tiempo que seguiría siendo humano</li>
							<li><span class="info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"></path><path d="M7 15l4-4 3 3 5-6"></path></svg></span>Proyección mensual y anual</li>
						</ul>
						<p class="info-note"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 8h.01"></path><path d="M11 11.5h1v4.5h1"></path></svg>El resultado será orientativo y dependerá del proceso, sus excepciones y las herramientas utilizadas.</p>
					</div>
				</div>

				<div class="bottom-row">
					<p class="privacy-note"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>Tus datos no se guardan.</p>
					<div class="nav-buttons">
						<button type="button" class="btn-continue" data-continue="1">Continuar <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></button>
					</div>
				</div>
			</div>

			<!-- Paso 2 — Tiempo y frecuencia -->
			<div data-step="2" class="step-view" hidden>
				<div class="step-grid">
					<div class="form-col">
						<h3>¿Cuánto tiempo ocupa actualmente?</h3>

						<div class="field">
							<label for="est-frecuencia">¿Cuántas veces se realiza esta tarea al mes?</label>
							<div class="field-unit">
								<input type="text" inputmode="numeric" id="est-frecuencia" placeholder="Ej. 120" autocomplete="off" />
								<span class="unit">veces al mes</span>
							</div>
							<p class="field-help">Indica el número total de repeticiones mensuales de esta tarea.</p>
						</div>

						<div class="field">
							<label for="est-tiempo">¿Cuánto tarda cada persona en completar una repetición?</label>
							<div class="field-unit">
								<input type="text" inputmode="decimal" id="est-tiempo" placeholder="Ej. 15" autocomplete="off" />
								<span class="unit">minutos</span>
							</div>
							<p class="field-help">Introduce el tiempo medio por persona para completar o revisar una repetición.</p>
						</div>

						<p class="form-error" data-error="2" role="alert" hidden></p>
					</div>

					<div class="info-col">
						<h4>¿Qué vamos a calcular?</h4>
						<ul class="info-list">
							<li><span class="info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg></span>Tiempo manual actual</li>
							<li><span class="info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"></path><path d="M3 4v5h5"></path><path d="M12 7v5l3 2"></path></svg></span>Horas que podrían recuperarse</li>
							<li><span class="info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 4-6 8-6s8 2 8 6"></path></svg></span>Tiempo que seguiría siendo humano</li>
							<li><span class="info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"></path><path d="M7 15l4-4 3 3 5-6"></path></svg></span>Proyección mensual y anual</li>
						</ul>
						<p class="info-note"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 8h.01"></path><path d="M11 11.5h1v4.5h1"></path></svg>El resultado será orientativo y dependerá del proceso, sus excepciones y las herramientas utilizadas.</p>
					</div>
				</div>

				<div class="bottom-row">
					<p class="privacy-note"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>Tus datos no se guardan.</p>
					<div class="nav-buttons">
						<button type="button" class="btn-back" data-back="2">Volver</button>
						<button type="button" class="btn-continue" data-continue="2">Continuar <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></button>
					</div>
				</div>
			</div>

			<!-- Paso 3 — Automatización -->
			<div data-step="3" class="step-view" hidden>
				<div class="step-grid">
					<div class="form-col">
						<h3>¿Qué parte podría automatizarse?</h3>

						<div class="field">
							<span class="toggle-label" id="est-pct-label">¿Qué parte de la tarea crees que podría realizarse automáticamente?</span>
							<div class="pct-grid" role="group" aria-labelledby="est-pct-label" data-pct-grid>
								<button type="button" class="pct-btn" data-pct="25">
									<span class="pct-value">25 %</span>
									<span class="pct-desc">Una parte pequeña</span>
								</button>
								<button type="button" class="pct-btn" data-pct="50">
									<span class="pct-value">50 %</span>
									<span class="pct-desc">Aproximadamente la mitad</span>
								</button>
								<button type="button" class="pct-btn" data-pct="75">
									<span class="pct-value">75 %</span>
									<span class="pct-desc">La mayor parte</span>
								</button>
								<button type="button" class="pct-btn" data-pct="90">
									<span class="pct-value">90 %</span>
									<span class="pct-desc">Casi todo, con revisión humana</span>
								</button>
							</div>
							<button type="button" class="pct-custom-toggle" data-pct-custom-toggle aria-expanded="false">Personalizado · Introducir otro porcentaje</button>
							<div class="field field-custom" data-pct-custom-field hidden>
								<label for="est-pct-custom">Porcentaje automatizable</label>
								<div class="field-unit">
									<input type="text" inputmode="numeric" id="est-pct-custom" placeholder="Ej. 60" autocomplete="off" />
									<span class="unit">%</span>
								</div>
							</div>
						</div>

						<div class="field">
							<span class="toggle-label" id="est-coste-label">¿Quieres estimar también el valor económico de ese tiempo?</span>
							<p class="field-help field-help-top">Opcional</p>
							<div class="pill-toggle" role="group" aria-labelledby="est-coste-label" data-toggle="mostrar-coste">
								<button type="button" class="pill-btn" data-value="no" aria-pressed="true">No</button>
								<button type="button" class="pill-btn" data-value="si" aria-pressed="false">Sí</button>
							</div>
						</div>

						<div class="field" data-coste-field hidden>
							<label for="est-coste">Coste aproximado por hora</label>
							<div class="field-unit">
								<input type="text" inputmode="decimal" id="est-coste" placeholder="Ej. 22" autocomplete="off" />
								<span class="unit">€/hora</span>
							</div>
							<p class="field-help">Puedes utilizar una estimación del coste laboral total por hora.</p>
						</div>

						<p class="form-error" data-error="3" role="alert" hidden></p>
					</div>

					<div class="info-col">
						<h4>Antes de calcular</h4>
						<ul class="info-list">
							<li><span class="info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 8h.01"></path><path d="M11 11.5h1v4.5h1"></path></svg></span>El porcentaje es una estimación, no una garantía.</li>
							<li><span class="info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 4-6 8-6s8 2 8 6"></path></svg></span>Las revisiones y excepciones seguirán necesitando intervención humana.</li>
							<li><span class="info-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M8 12h8"></path><path d="M12 8v8"></path></svg></span>El coste por hora es opcional.</li>
						</ul>
						<p class="info-note"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 8h.01"></path><path d="M11 11.5h1v4.5h1"></path></svg>No mostramos el 100 % como opción rápida porque normalmente siguen existiendo controles y excepciones.</p>
					</div>
				</div>

				<div class="bottom-row">
					<p class="privacy-note"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>Tus datos no se guardan.</p>
					<div class="nav-buttons">
						<button type="button" class="btn-back" data-back="3">Volver</button>
						<button type="button" class="btn-continue" data-continue="3">Calcular resultado <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></button>
					</div>
				</div>
			</div>

			<!-- Paso 4 — Resultado -->
			<div data-step="4" class="step-view" hidden>
				<h3>Tu estimación</h3>
				<p class="result-tarea">Tarea analizada: <strong data-result-tarea></strong></p>

				<div class="stat-grid">
					<div class="stat-card stat-primary">
						<p class="stat-value"><span data-result-ha></span> h</p>
						<p class="stat-label">recuperables al mes</p>
					</div>
					<div class="stat-card">
						<p class="stat-value"><span data-result-haa></span> h</p>
						<p class="stat-label">recuperables al año</p>
					</div>
					<div class="stat-card">
						<p class="stat-value"><span data-result-hm></span> h</p>
						<p class="stat-label">trabajo actual al mes</p>
					</div>
					<div class="stat-card">
						<p class="stat-value"><span data-result-hr></span> h</p>
						<p class="stat-label">seguirían necesitando intervención humana</p>
					</div>
				</div>

				<div class="time-bar-box">
					<div class="time-bar-labels">
						<span>Tiempo actual <strong data-result-hm-label></strong></span>
						<span>Tiempo automatizable <strong data-result-ha-label></strong></span>
						<span>Intervención humana <strong data-result-hr-label></strong></span>
					</div>
					<div class="time-bar-track">
						<div class="time-bar-fill" data-time-bar-fill></div>
					</div>
				</div>

				<div class="valor-economico" data-valor-economico hidden>
					<p class="valor-label">Valor económico orientativo</p>
					<p class="valor-numbers"><span data-result-ve-m></span> €/mes <strong>·</strong> <span data-result-ve-a></span> €/año</p>
					<p class="valor-nota">Calculado con un coste estimado de <span data-result-coste-hora></span> €/hora. Tiempo liberado no significa automáticamente ahorro económico.</p>
				</div>

				<p class="legal-note">
					Esta estimación parte del porcentaje de automatización que has indicado. Antes de confirmar el ahorro
					real habría que revisar las reglas del proceso, sus excepciones, las herramientas actuales, la
					calidad de los datos y el tiempo de supervisión necesario.
				</p>

				<div class="bottom-row">
					<p class="privacy-note"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>Tus datos no se guardan.</p>
					<div class="nav-buttons">
						<button type="button" class="btn-back" data-modificar>Modificar datos</button>
						<a class="btn-continue" data-cta-analizar href="/#contacto">Analizar este proceso</a>
					</div>
				</div>
			</div>
		</div>

		<p class="fiscal-note">La estimación no confirma que el proceso pueda automatizarse.</p>
	</div>
</section>

<style>
	.estimador {
		padding: 88px 24px;
		background: var(--color-bg);
	}

	.wrap {
		max-width: 940px;
		margin: 0 auto;
		text-align: center;
	}

	.eyebrow {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 13px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-accent);
		margin: 0 0 18px;
	}

	h2 {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: clamp(28px, 3.6vw, 40px);
		color: var(--color-text);
		margin: 0 0 14px;
	}

	.subtitle {
		font-family: var(--font-body);
		font-size: 16px;
		color: var(--color-muted);
		margin: 0 0 40px;
	}

	.card {
		text-align: left;
		background: #fff;
		border: 1px solid var(--color-divider);
		border-radius: 24px;
		box-shadow: var(--shadow-sm);
		padding: 40px;
	}

	.step-caption {
		margin: 0 0 18px;
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 14.5px;
		color: var(--color-text);
	}

	.stepper {
		display: flex;
		align-items: center;
		margin: 0 0 36px;
	}

	.stepper-item {
		display: flex;
		align-items: center;
		gap: 10px;
		flex: 0 0 auto;
	}

	.stepper-circle {
		flex: 0 0 auto;
		width: 30px;
		height: 30px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 14px;
		background: var(--color-accent-200);
		color: var(--color-accent-800);
	}

	.stepper-item[data-state="done"] .stepper-circle {
		background: var(--color-accent-300);
		color: var(--color-accent-900);
	}

	.stepper-item[data-state="current"] .stepper-circle {
		background: var(--color-accent-900);
		color: #fff;
	}

	.stepper-label {
		display: none;
		font-family: var(--font-body);
		font-size: 14px;
		color: var(--color-muted);
		white-space: nowrap;
	}

	@media (min-width: 600px) {
		.stepper-label {
			display: block;
		}
	}

	.stepper-item[data-state="current"] .stepper-label,
	.stepper-item[data-state="done"] .stepper-label {
		color: var(--color-text);
		font-weight: 600;
	}

	.stepper-line {
		flex: 1 1 auto;
		height: 2px;
		background: var(--color-divider);
		margin: 0 14px;
	}

	.stepper-line[data-state="done"] {
		background: var(--color-accent-900);
	}

	.step-grid {
		display: grid;
		gap: 32px;
	}

	.form-col h3 {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 20px;
		color: var(--color-text);
		margin: 0 0 22px;
	}

	.field {
		margin: 0 0 20px;
	}

	.field label,
	.toggle-label {
		display: block;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 14.5px;
		color: var(--color-text);
		margin: 0 0 8px;
	}

	.field-help {
		margin: 6px 0 0;
		font-family: var(--font-body);
		font-size: 13px;
		line-height: 1.5;
		color: var(--color-muted);
	}

	.field-help-top {
		margin: -4px 0 8px;
	}

	.field input,
	.field select,
	.field textarea {
		width: 100%;
		background: var(--color-bg);
		border: 1px solid var(--color-divider);
		border-radius: 12px;
		padding: 13px 16px;
		color: var(--color-text);
		font-family: var(--font-body);
		font-size: 15.5px;
		outline: none;
	}

	.field textarea {
		resize: vertical;
	}

	.field input:focus,
	.field select:focus,
	.field textarea:focus {
		border-color: var(--color-accent);
	}

	.field-unit {
		display: flex;
		align-items: stretch;
		border: 1px solid var(--color-divider);
		border-radius: 12px;
		overflow: hidden;
		background: var(--color-bg);
	}

	.field-unit input {
		border: none;
		border-radius: 0;
		flex: 1;
		background: transparent;
	}

	.field-unit .unit {
		flex: 0 0 auto;
		display: flex;
		align-items: center;
		padding: 0 16px;
		font-family: var(--font-body);
		font-size: 14px;
		color: var(--color-muted);
		background: var(--color-accent-100);
