</style>

<script>
	const section = document.querySelector<HTMLElement>("#simulador.estimador");
	if (section) {
		const stepViews = Array.from(section.querySelectorAll<HTMLElement>("[data-step]"));
		const stepCaption = section.querySelector<HTMLElement>("[data-step-caption]");
		const stepperItems = Array.from(section.querySelectorAll<HTMLElement>("[data-stepper-item]"));
		const stepperLines = Array.from(section.querySelectorAll<HTMLElement>("[data-stepper-line]"));

		const stepMeta = [
			"Paso 1 de 3 · La tarea",
			"Paso 2 de 3 · Tiempo y frecuencia",
			"Paso 3 de 3 · Automatización",
			"Resultado de la estimación",
		];

		let currentStep = 1;
		let pctAutomatizable: number | null = null;
		let mostrarCoste: "no" | "si" = "no";

		function parseEsNumber(raw: string): number | null {
			let s = raw.trim().replace(/€|%/g, "").replace(/\s/g, "");
			if (!s) return null;
			const hasComma = s.includes(",");
			const hasDot = s.includes(".");
			if (hasComma && hasDot) {
				s = s.replace(/\./g, "").replace(",", ".");
			} else if (hasComma) {
				s = s.replace(",", ".");
			} else if (hasDot) {
				const parts = s.split(".");
				const lastPart = parts[parts.length - 1];
				if (parts.length > 1 && lastPart.length === 3) {
					s = parts.join("");
				}
			}
			const n = Number(s);
			return Number.isFinite(n) ? n : null;
		}

		function formatEs(n: number, maxDecimals = 1): string {
			return new Intl.NumberFormat("es-ES", { maximumFractionDigits: maxDecimals, useGrouping: true }).format(n);
		}

		function bindPillToggle(container: Element, onChange: (value: string) => void) {
			const buttons = Array.from(container.querySelectorAll<HTMLButtonElement>(".pill-btn"));
			buttons.forEach((btn) => {
				btn.addEventListener("click", () => {
					buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
					onChange(btn.dataset.value ?? "");
				});
			});
		}

		bindPillToggle(section.querySelector('[data-toggle="mostrar-coste"]')!, (value) => {
			mostrarCoste = value === "si" ? "si" : "no";
			const field = section.querySelector<HTMLElement>("[data-coste-field]");
			if (field) field.hidden = mostrarCoste !== "si";
		});

		const pctButtons = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-pct]"));
		const pctCustomField = section.querySelector<HTMLElement>("[data-pct-custom-field]");
		const pctCustomInput = section.querySelector<HTMLInputElement>("#est-pct-custom");
		const pctCustomToggle = section.querySelector<HTMLButtonElement>("[data-pct-custom-toggle]");

		pctButtons.forEach((btn) => {
			btn.addEventListener("click", () => {
				pctButtons.forEach((b) => b.setAttribute("aria-pressed", "false"));
				btn.setAttribute("aria-pressed", "true");
				pctAutomatizable = Number(btn.dataset.pct);
				if (pctCustomInput) pctCustomInput.value = "";
			});
		});

		pctCustomToggle?.addEventListener("click", () => {
			if (!pctCustomField) return;
			const isOpen = !pctCustomField.hidden;
			pctCustomField.hidden = isOpen;
			pctCustomToggle.setAttribute("aria-expanded", String(!isOpen));
			if (!isOpen) {
				pctButtons.forEach((b) => b.setAttribute("aria-pressed", "false"));
				pctCustomInput?.focus();
			}
		});

		pctCustomInput?.addEventListener("input", () => {
			const val = parseEsNumber(pctCustomInput.value);
			pctAutomatizable = val;
		});

		function showError(step: number, message: string) {
			const el = section?.querySelector<HTMLElement>(`[data-error="${step}"]`);
			if (!el) return;
			el.textContent = message;
			el.hidden = false;
		}

		function clearError(step: number) {
			const el = section?.querySelector<HTMLElement>(`[data-error="${step}"]`);
			if (!el) return;
			el.hidden = true;
			el.textContent = "";
		}

		function validateStep1(): boolean {
			clearError(1);
			const tipo = (section?.querySelector<HTMLSelectElement>("#est-tipo"))?.value;
			const personas = parseEsNumber((section?.querySelector<HTMLInputElement>("#est-personas"))?.value ?? "");
			if (!tipo) {
				showError(1, "Selecciona el tipo de tarea que quieres analizar.");
				return false;
			}
			if (personas === null) {
				showError(1, "Indica al menos una persona implicada en la tarea.");
				return false;
			}
			if (personas <= 0) {
				showError(1, "Indica al menos una persona implicada en la tarea.");
				return false;
			}
			if (!Number.isInteger(personas)) {
				showError(1, "El número de personas debe ser un número entero.");
				return false;
			}
			return true;
		}

		function validateStep2(): boolean {
			clearError(2);
			const frecuencia = parseEsNumber((section?.querySelector<HTMLInputElement>("#est-frecuencia"))?.value ?? "");
			const tiempo = parseEsNumber((section?.querySelector<HTMLInputElement>("#est-tiempo"))?.value ?? "");
			if (frecuencia === null || tiempo === null) {
				showError(2, "Completa los datos de frecuencia y tiempo para realizar la estimación.");
				return false;
			}
			if (frecuencia < 0 || tiempo < 0) {
				showError(2, "Las cantidades no pueden ser negativas.");
				return false;
			}
			if (frecuencia === 0) {
				showError(2, "Si la tarea no se realiza actualmente, no existen horas mensuales que estimar.");
				return false;
			}
			if (tiempo === 0) {
				showError(2, "Indica cuánto tarda actualmente cada persona en completar la tarea.");
				return false;
			}
			const personas = parseEsNumber((section?.querySelector<HTMLInputElement>("#est-personas"))?.value ?? "") ?? 1;
			const horasActuales = (personas * frecuencia * tiempo) / 60;
			if (horasActuales > personas * 200) {
				showError(2, "Los datos introducidos equivalen a más horas de trabajo de las disponibles para el equipo durante el mes. Comprueba si el tiempo indicado corresponde a cada persona o al total del equipo.");
				return false;
			}
			return true;
		}

		function validateStep3(): boolean {
			clearError(3);
			if (pctAutomatizable === null) {
				showError(3, "Indica qué parte de la tarea crees que podría automatizarse.");
				return false;
			}
			if (pctAutomatizable < 0 || pctAutomatizable > 100) {
				showError(3, "El porcentaje automatizable debe estar entre 0 % y 100 %.");
				return false;
			}
			if (pctAutomatizable === 100) {
				const confirmado = window.confirm(
					"Has indicado que el proceso podría funcionar sin tiempo de revisión, control ni gestión de excepciones. Confirma este dato únicamente si refleja realmente el proceso.",
				);
				if (!confirmado) return false;
			}
			if (mostrarCoste === "si") {
				const coste = parseEsNumber((section?.querySelector<HTMLInputElement>("#est-coste"))?.value ?? "");
				if (coste === null || coste < 0) {
					showError(3, "Indica un coste por hora válido, o marca 'No' si no quieres estimarlo.");
					return false;
				}
			}
			return true;
		}

		function updateStepper(step: number) {
			stepperItems.forEach((item) => {
				const n = Number(item.dataset.stepperItem);
				const circle = item.querySelector("[data-stepper-circle]");
				if (n < step) {
					item.dataset.state = "done";
					if (circle) circle.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>';
				} else if (n === step) {
					item.dataset.state = "current";
					if (circle) circle.textContent = String(n);
				} else {
					item.dataset.state = "";
					if (circle) circle.textContent = String(n);
				}
			});
			stepperLines.forEach((line) => {
				const n = Number(line.dataset.stepperLine);
				line.dataset.state = n < step ? "done" : "";
			});
		}

		function goToStep(step: number) {
			currentStep = step;
			stepViews.forEach((view) => {
				view.hidden = Number(view.dataset.step) !== step;
			});
			if (stepCaption) stepCaption.textContent = stepMeta[step - 1];
			updateStepper(Math.min(step, 3));
			const stepView = section?.querySelector<HTMLElement>(`[data-step="${step}"]`);
			const heading = stepView?.querySelector<HTMLElement>("h3");
			heading?.setAttribute("tabindex", "-1");
			heading?.focus({ preventScroll: true });
		}

		function calcular() {
			const personas = parseEsNumber((section?.querySelector<HTMLInputElement>("#est-personas"))?.value ?? "") ?? 0;
			const frecuencia = parseEsNumber((section?.querySelector<HTMLInputElement>("#est-frecuencia"))?.value ?? "") ?? 0;
			const tiempo = parseEsNumber((section?.querySelector<HTMLInputElement>("#est-tiempo"))?.value ?? "") ?? 0;
			const pct = pctAutomatizable ?? 0;
			const tipoSelect = section?.querySelector<HTMLSelectElement>("#est-tipo");
			const tipoTexto = tipoSelect?.selectedOptions[0]?.textContent ?? "";

			const hm = (personas * frecuencia * tiempo) / 60;
			const ha = hm * (pct / 100);
			const hr = hm - ha;
			const haa = ha * 12;

			const setText = (selector: string, value: string) => {
				const el = section?.querySelector<HTMLElement>(selector);
				if (el) el.textContent = value;
			};

			setText("[data-result-tarea]", tipoTexto);
			setText("[data-result-ha]", formatEs(ha));
			setText("[data-result-haa]", formatEs(haa));
			setText("[data-result-hm]", formatEs(hm));
			setText("[data-result-hr]", formatEs(hr));
			setText("[data-result-hm-label]", `${formatEs(hm)} h`);
			setText("[data-result-ha-label]", `${formatEs(ha)} h`);
			setText("[data-result-hr-label]", `${formatEs(hr)} h`);

			const fill = section?.querySelector<HTMLElement>("[data-time-bar-fill]");
			if (fill) fill.style.width = hm > 0 ? `${(ha / hm) * 100}%` : "0%";

			const valorBox = section?.querySelector<HTMLElement>("[data-valor-economico]");
			let resumen = `He utilizado el estimador de automatización para analizar una tarea de ${tipoTexto.toLowerCase()}. Según los datos introducidos, consume aproximadamente ${formatEs(hm)} horas al mes y podría liberar unas ${formatEs(ha)} horas mensuales. Me gustaría revisar si el proceso puede automatizarse.`;

			if (mostrarCoste === "si") {
				const coste = parseEsNumber((section?.querySelector<HTMLInputElement>("#est-coste"))?.value ?? "") ?? 0;
				const veM = ha * coste;
				const veA = haa * coste;
				setText("[data-result-ve-m]", formatEs(veM, 2));
				setText("[data-result-ve-a]", formatEs(veA, 2));
				setText("[data-result-coste-hora]", formatEs(coste, 2));
				if (valorBox) valorBox.hidden = false;
			} else if (valorBox) {
				valorBox.hidden = true;
			}

			try {
				sessionStorage.setItem("estimadorHorasResumen", resumen);
			} catch {
				/* sessionStorage no disponible: se omite el prellenado del formulario */
			}
		}

		section.querySelectorAll<HTMLButtonElement>("[data-continue]").forEach((btn) => {
			btn.addEventListener("click", () => {
				const from = Number(btn.dataset.continue);
				if (from === 1 && !validateStep1()) return;
				if (from === 2 && !validateStep2()) return;
				if (from === 3 && !validateStep3()) return;
				if (from === 3) calcular();
				goToStep(from + 1);
			});
		});

		section.querySelectorAll<HTMLButtonElement>("[data-back]").forEach((btn) => {
			btn.addEventListener("click", () => {
				const from = Number(btn.dataset.back);
				goToStep(from - 1);
			});
		});

		section.querySelector<HTMLButtonElement>("[data-modificar]")?.addEventListener("click", () => {
			goToStep(1);
		});

		section.querySelector<HTMLAnchorElement>("[data-cta-analizar]")?.addEventListener("click", () => {
			const field = document.querySelector<HTMLElement>("#contacto [data-simulacion-field]");
			const textarea = document.querySelector<HTMLTextAreaElement>("#contacto #datos-simulacion");
			const resumen = sessionStorage.getItem("estimadorHorasResumen");
			if (field && textarea && resumen && !textarea.value) {
				textarea.value = resumen;
				field.hidden = false;
			}
		});

		goToStep(1);
	}
</script>
