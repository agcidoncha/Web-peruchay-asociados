---
const areaLinks = [
	{ href: "/finanzas-y-control", label: "Finanzas y Control" },
	{ href: "/contabilidad-y-fiscalidad", label: "Contabilidad y Fiscalidad" },
	{ href: "/digitalizacion-y-automatizacion", label: "Digitalización y Automatización" },
];

const year = new Date().getFullYear();
---

<div class="desktop-only">
	<footer class="site-footer">
		<div class="grid">
			<div>
				<p class="name">Perucha y Asociados</p>
				<p class="nap"><a class="phone" href="tel:+34639003817">639 00 38 17</a></p>
				<p class="tagline">Tu visión, nuestra dedicación.</p>
			</div>
			<nav aria-label="Áreas">
				<p class="col-title">Áreas</p>
				{areaLinks.map((link) => (
					<a href={link.href}>{link.label}</a>
				))}
			</nav>
		</div>
		<div class="bottom">
			<span>© {year} Perucha y Asociados</span>
			<nav class="legal-links" aria-label="Legal">
				<a href="/aviso-legal">Aviso legal</a>
				<a href="/politica-privacidad">Política de privacidad</a>
				<a href="/politica-cookies">Política de cookies</a>
				<button type="button" class="legal-btn" data-open-cookie-settings>Configurar cookies</button>
			</nav>
		</div>
	</footer>
</div>

<footer class="mobile-only footer-lab">
	<nav class="footer-areas" aria-label="Áreas">
		{areaLinks.map((link) => (
			<a href={link.href}>{link.label}</a>
		))}
	</nav>
	<nav class="footer-legal" aria-label="Legal">
		<a href="/aviso-legal">Aviso legal</a>
		<a href="/politica-privacidad">Política de privacidad</a>
		<a href="/politica-cookies">Política de cookies</a>
		<button type="button" class="footer-legal-btn" data-open-cookie-settings>Configurar cookies</button>
	</nav>
	<p class="footer-copyright">© {year} Perucha y Asociados</p>
</footer>

<script>
	import { OPEN_SETTINGS_EVENT } from "../lib/cookieConsent";

	document.querySelectorAll("[data-open-cookie-settings]").forEach((button) => {
		button.addEventListener("click", () => {
			window.dispatchEvent(new CustomEvent(OPEN_SETTINGS_EVENT));
		});
	});
</script>

<style>
	.site-footer {
		background: var(--color-accent-900);
		padding: 56px 24px 32px;
	}

	.grid {
		max-width: 1180px;
		margin: 0 auto;
		display: grid;
		gap: 40px;
		grid-template-columns: 1fr;
	}

	.name {
		font-family: var(--font-heading);
		font-weight: var(--font-heading-weight);
		font-size: 20px;
		color: #fff;
		margin: 0 0 10px;
	}

	.nap {
		margin: 0 0 4px;
		font-size: 14px;
		color: rgba(255, 255, 255, 0.7);
	}

	.nap:has(.phone) {
		margin-bottom: 22px;
	}

	.phone {
		color: rgba(255, 255, 255, 0.7);
		text-decoration: none;
	}

	.phone:hover {
		color: #fff;
		text-decoration: underline;
	}

	.tagline {
		font-family: var(--font-heading);
		font-size: 15px;
		color: rgba(255, 255, 255, 0.85);
		margin: 0;
	}

	nav {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.col-title {
		margin: 0 0 4px;
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: rgba(255, 255, 255, 0.45);
	}

	nav a {
		color: rgba(255, 255, 255, 0.8);
		text-decoration: none;
		font-size: 15px;
	}

	nav a:hover {
		color: #fff;
	}

	.bottom {
		max-width: 1180px;
		margin: 36px auto 0;
		padding-top: 22px;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		font-size: 13px;
		color: rgba(255, 255, 255, 0.4);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 14px;
		text-align: center;
	}

	.legal-links {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px 20px;
	}

	.legal-links a,
	.legal-btn {
		color: rgba(255, 255, 255, 0.4);
		text-decoration: none;
	}

	.legal-links a:hover,
	.legal-btn:hover {
		color: rgba(255, 255, 255, 0.75);
	}

	.legal-btn {
		background: transparent;
		border: none;
		padding: 0;
		font-family: inherit;
		font-size: inherit;
		cursor: pointer;
	}

	@media (min-width: 700px) {
		.grid {
			grid-template-columns: 1.3fr 1fr;
		}

		.bottom {
			flex-direction: row;
			justify-content: space-between;
			text-align: left;
		}
	}

	.mobile-only {
		display: none;
	}

	.footer-lab {
		background: var(--color-accent-900);
		padding: 32px 15px;
		text-align: center;
	}

	.footer-areas,
	.footer-legal {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 6px 14px;
		margin: 0 0 16px;
		padding-bottom: 16px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.12);
	}

	.footer-legal {
		border-bottom: none;
		margin-bottom: 16px;
	}

	.footer-areas a,
	.footer-legal a,
	.footer-legal-btn {
		font-family: var(--font-body);
		font-size: 13px;
		color: rgba(255, 255, 255, 0.75);
		text-decoration: none;
	}

	.footer-legal-btn {
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
	}

	.footer-areas a:hover,
	.footer-legal a:hover,
	.footer-legal-btn:hover {
		color: #fff;
	}

	.footer-copyright {
		font-family: var(--font-body);
		font-size: 12px;
		color: rgba(255, 255, 255, 0.4);
		margin: 0;
	}

	@media (max-width: 599px) {
		.desktop-only {
			display: none;
		}

		.mobile-only {
			display: block;
		}
	}
</style>
