---
interface Step {
	n: string;
	title: string;
	text: string;
}

interface Props {
	title: string;
	steps: Step[];
	closing?: string;
}

const { title, steps, closing } = Astro.props;
---

<section class="how">
	<div class="wrap">
		<h2>{title}</h2>
		<div class="steps">
			{steps.map((step) => (
				<div class="step">
					<span class="n">{step.n}</span>
					<div>
						<h4>{step.title}</h4>
						<p>{step.text}</p>
					</div>
				</div>
			))}
		</div>
		{closing && <p class="closing">{closing}</p>}
	</div>
</section>

<style>
	.how {
		padding: 88px 24px;
		background: var(--color-surface);
	}

	.wrap {
		max-width: 860px;
		margin: 0 auto;
	}

	h2 {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: clamp(26px, 3.6vw, 36px);
		text-align: center;
		color: var(--color-text);
		margin: 0 0 44px;
	}

	.steps {
		display: flex;
		flex-direction: column;
	}

	.step {
		display: flex;
		gap: 20px;
		padding: 22px 0;
		border-bottom: 1px solid var(--color-divider);
	}

	.step:last-child {
		border-bottom: none;
	}

	.n {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 22px;
		color: var(--color-accent);
		flex: 0 0 40px;
	}

	.step h4 {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 18px;
		color: var(--color-text);
		margin: 0 0 6px;
	}

	.step p {
		margin: 0;
		font-family: var(--font-body);
		font-size: 14.5px;
		line-height: 1.6;
		color: var(--color-muted);
	}

	.closing {
		margin: 32px 0 0;
		text-align: center;
		font-family: var(--font-body);
		font-size: 14.5px;
		line-height: 1.6;
		color: var(--color-muted);
		max-width: 680px;
		margin-left: auto;
		margin-right: auto;
	}

	@media (max-width: 599px) {
		.how {
			padding: 25px 15px;
		}
	}
</style>
